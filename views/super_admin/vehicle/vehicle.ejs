
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="card shadow-lg border-0 custom-card" style="border-radius: 20px; background: linear-gradient(145deg, #ffffff, #f0f2f7);">
          <!-- <div class="card-body"> -->
            <!-- <button type="button" class="btn btn-primary" id="myBtn"
              style="float: inline-end;border-radius: 6px;width: 6vw;cursor: pointer;">Add</button> -->
          <!-- </div> -->
          <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
          <h3 class="card-title mb-0 text-gradient fw-bold">
              <i class="fas fa-car text-dark"></i> Vehicle
            </h3>
             <button type="button" class="btn btn-gradient" id="myBtn">
              <i class="fa fa-plus"></i> Add
            </button>
          </div>


           <!-- Filter Form -->
        <% if(user.userData.user_type == "S"){ %>
        <form action="/superadmin/vehicle" method="post" class="p-3">
          <div class="row g-3 align-items-end justify-content-center">
            <div class="col-md-5">
              <label for="cust_name" class="form-label fw-semibold text-dark"><b>Location Name:</b></label>
              <select name="cust_name" class="form-control custom-select" id="cust_name" required>
                <option value="">Select Location Name</option>
                <% customer.forEach(dt => {
                  var _selected = ''
                  if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                  <option value="<%= dt.customer_id %>" <%= _selected %>>
                    <%= dt.customer_name %>
                  </option>
                <% })%>
              </select>
            </div>
            <div class="col-md-4">
              <button type="submit" class="btn btn-gradient w-50" id="submitBtn">
                <i class="fa fa-search"></i> Submit
              </button>
            </div>
          </div>
        </form>
        <% } %>


          <%# if(selected.cust_id > 0){ %>
            <% if((user.userData.user_type == "S" && selected.cust_id > 0) || user.userData.user_type == "A"){ %>
            <!-- <div class="row"> -->
              <!-- <div class="col-md-12"> -->
                <div class="table-responsive p-3">
                  <table id="dataTable" class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
                      <thead class="custom-header text-center">
                          <tr>
                              <th class="text-center text-dark">Sl No.</th>
                              <th class="text-center text-dark">Vehicle Name</th>
                              <th class="text-center text-dark">Vehicle ON/OFF</th>
                              <th class="text-center text-dark">Action</th>
                          </tr>
                      </thead>
                      <tbody>
                        <% if(data.length > 0){
                          var i = 1
                          data.forEach(dt => { %>
                            <tr>
                              <td class="text-center text-dark"><%= i %></td>
                              <td class="text-center text-dark"><%= dt.vehicle_name %></td>
                              <td class="text-center text-dark">
                           <div class="form-check form-switch d-inline-block">
                               <input 
                                 class="form-check-input" 
                                 type="checkbox" 
                                 id="vehSwitch_<%= dt.vehicle_id %>" 
                                 name="vehicle_on_off" 
                                 <%= dt.vehicle_on_off == 'Y' ? "checked" : "" %> 
                                 disabled>

                               <label 
                                 class="form-check-label fw-bold <%= dt.vehicle_on_off == 'Y' ? 'text-success' : 'text-danger' %>" 
                                 for="vehSwitch_<%= dt.vehicle_id %>">
                                 <%= dt.vehicle_on_off == 'Y' ? "ON" : "OFF" %>
                               </label>
                              </div>
                              </td>
                              <td class="text-center text-dark"><a href='/superadmin/edit_vehicle?customer_id=<%= (user.userData.user_type == "A" ? user.userData.customer_id : selected.cust_id) %>&id=<%= dt.vehicle_id %>' class='btn btn-info' style='border-radius:5px'><i class='fa fa-edit'></i></a></td>
                            </tr>
                        <% i++; })
                        }else{ %>
                          <tr>
                            <td class="text-center text-danger" colspan="4">No data found</td>
                          </tr>
                        <% } %>
                      </tbody>
                      <tfoot></tfoot>
                  </table>
                </div>
              <!-- </div> -->
            <!-- </div> -->
          <% } %>
        </div>
      </div>
    </div>
  </div>


  <div class="modal fade" id="myModal">
    <div class="modal-dialog modal-dialog-centered modal-lg-custom">
      <div class="modal-content rounded-4 shadow-lg glass-bg border-0">
        <!-- Modal Header -->
        <div class="modal-header border-0">
          <h3 class="modal-title fw-bold text-dark">
            <i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Vehicle</b>
          </h3>
          <!-- <button type="button" class="close" data-dismiss="modal">
            &times;
          </button> -->
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/superadmin/vehicle_save" method="post" id="myForm">
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                    <label for="cust_name_modal" class="form-label fw-semibold text-dark"><b>Location Name</b></label>
                    <% if (user.userData.user_type === 'S') { %>
                      <!-- Show dropdown if user_type is S -->
                  <select name="cust_name" class="form-control" id="cust_name_modal">
                    <option value="">Select Location Name</option>
                    <% customer.forEach(dt => { %>
                      <option value="<%= dt.customer_id %>"><%= dt.customer_name %></option>
                    <% }) %>
                  </select>
                <% } else { %>
                  <!-- Auto-select & show location name for others (e.g. A) -->
                <% 
                  let selectedCust = customer.find(c => c.customer_id == user.userData.customer_id);
                %>
                <input type="hidden" name="cust_name" value="<%= user.userData.customer_id %>">
                <input type="text" class="form-control" value="<%= selectedCust ? selectedCust.customer_name : '' %>" disabled>
              <% } %>
                </div>
            </div>
                <div class="col-md-6">
                  <!-- <div class="form-group"> -->
                    <label for="veh_name" class="form-label fw-semibold text-dark"><b>Vehicle Name</b></label>
                    <input type="text" class="form-control" id="veh_name" name="veh_name" placeholder="Enter Vehicle Name.....">
                  <!-- </div> -->
                  </div>
            </div>
            <div class="row">
                <input type="hidden" name="id" value="0">
                <div class="form-group col-md-5"></div>
               <div class="row">
            <div class="col-12 text-center">
            <input type="submit" value="SUBMIT"  id="submitBtn" class="btn btn-gradient px-5 py-2 rounded-pill">
             </div>
            </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>


<style>
  /* Bootstrap override */
.form-check-input:checked {
  background-color: #28a745; /* Green when ON */
  border-color: #28a745;
}
.form-check-input:not(:checked) {
  background-color: #dc3545; /* Red when OFF */
  border-color: #dc3545;
}

     .cust-toggle1 {
    margin-top: 32px;
  }
/* Gradient Button */
.btn-gradient {
  background: linear-gradient(45deg, #dbbcda, #6d83e2);
  color: rgb(7, 5, 5);
  font-weight: 600;
  border: none;
  padding: 10px 20px;
  border-radius: 30px;
  transition: 0.3s;
}
.btn-gradient:hover {
  transform: scale(1.05);
  box-shadow: 0 5px 15px rgba(0,0,0,0.25);
  color: #fff;
}

/* Gradient Text */
.text-gradient {
  background: linear-gradient(to right, #b983b8, #4355a7);;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Custom Table */
#dataTable thead th {
  background: linear-gradient(45deg, #dbbcda, #6d83e2);
  color: #fff;
  font-weight: 600;
}
#dataTable tbody tr:hover {
  background-color: rgba(106, 17, 203, 0.08) !important;
  transition: 0.3s;
}

/* Glassmorphism Modal */
.glass-bg {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
}

/* Form Controls */
.form-control {
  border-radius: 12px;
  /* padding: 12px; */
}
.custom-select option {
  background: linear-gradient(45deg, #dbbcda, #6d83e2);
  color: #0e0a0a;
}
.modal-lg-custom {
  max-width: 50%;
}
.gradient-select {
  background: linear-gradient(90deg, #8e2de2, #4a00e0); /* Purple gradient */
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 10px 15px;
  font-size: 14px;
  appearance: none; /* removes default arrow */
  -webkit-appearance: none;
  -moz-appearance: none;
  cursor: pointer;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.gradient-select option {
  background: #fff; /* Dropdown list background */
  color: #333;      /* Dropdown list text */
}

.gradient-select:focus {
  outline: none;
  box-shadow: 0 0 0 2px rgba(142, 45, 226, 0.5);
}
.custom-card {
  border-radius: 20px; /* Rounded corners for whole card */
  overflow: hidden; /* Ensure inner elements respect the border-radius */
}
.card.p-0 {
  padding: 0 !important;
}
#cust_name,
#cust_name_modal {
  color: #000 !important; /* Dark text */
}

/* Optional: keep placeholder lighter */
#cust_name option:first-child,
#cust_name_modal option:first-child {
  color: #6c757d; /* light gray for placeholder */
}
</style>

<script>
    $(document).ready(function () {
      $("#myBtn").click(function () {
        $("#myModal").modal();
      });
    });
  </script>

