<div class="container-fluid">
    <div class="col-sm-12 col-md-12 col-lg-12">
      <div class="card">
        <div class="card-body">
          <div class="titleSec">
            <button type="button" class="btn btn-primary" id="myBtn"
              style="float: inline-end;border-radius: 6px;width: 6vw;cursor: pointer;">Add</button>
          </div>
          <div class="row mt-4">
            <h3 class="text-dark"><i class="fas fa-car"></i>&nbsp;<b>Vehicle</b>
            </h3>
          </div>
          <form action="/superadmin/vehicle" method="post">
            <div class="row mt-4">
              <div class="form-group col-md-5">
                <label for="cust_name"><b style="color: black;">Customer Name:</b></label>
                <select name="cust_name" class="form-control" id="cust_name" required>
                  <option value="">Select Customer Name</option>
                  <% customer.forEach(dt => {
                    var _selected = ''
                    if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                      <option value="<%= dt.customer_id %>" <%= _selected %>><%= dt.customer_name %></option>
                    <% })%>
                </select>
              </div>
              <div class="form-group col-md-4" style="margin-top: 30px;">
                <button type="submit" class="btn btn-primary" style="border-radius: 5px;" id="submitBtn">Submit</button>
              </div>
            </div>
          </form>
          <% if(selected.cust_id > 0){ %>
            <div class="row">
              <div class="col-md-12">
                <div class="table-responsive mt-3">
                  <table id="dataTable" class="table table-striped table-bordered no-wrap show_data">
                      <thead>
                          <tr>
                              <th class="text-center text-dark">Sl No.</th>
                              <th class="text-center text-dark">Vehicle Name</th>
                              <th class="text-center text-dark">Action</th>
                          </tr>
                      </thead>
                      <tbody>
                        <% if(data.length > 0){
                          var i = 1
                          data.forEach(dt => { %>
                            <tr>
                              <td class="text-center text-dark"><%= i %></td>
                              <td class="text-center text-dark"><%= dt.vehicle_name %></td>
                              <td class="text-center text-dark"><a href='/superadmin/edit_vehicle?customer_id=<%= selected.cust_id %>&id=<%= dt.vehicle_id %>' class='btn btn-info' style='border-radius:5px'><i class='fa fa-edit'></i></a></td>
                            </tr>
                        <% i++; })
                        }else{ %>
                          <tr>
                            <td class="text-center text-danger" colspan="3">No data found</td>
                          </tr>
                        <% } %>
                      </tbody>
                      <tfoot>
                         
                      </tfoot>
                  </table>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="myModal">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <h3 class="modal-title text-dark"><i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Vehicle</b>
          </h3>
          <button type="button" class="close" data-dismiss="modal">
            &times;
          </button>
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/superadmin/vehicle_save" method="post" id="myForm">
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                    <label for="cust_name" class="text-dark"><b>Customer Name</b></label>
                    <select name="cust_name" class="form-control" id="cust_name">
                        <option value="">Select Customer Name</option>
                        <% customer.forEach(dt => { %>
                          <option value="<%= dt.customer_id %>"><%= dt.customer_name %></option>
                          <% }) %>
                    </select>
                </div>
            </div>
                <div class="col-md-6">
                  <div class="form-group">
                    <label for="veh_name" class="text-dark"><b>Vehicle Name</b></label>
                    <input type="text" class="form-control" id="veh_name" name="veh_name" placeholder="Enter Vehicle Name.....">
                  </div>
                  </div>
            </div>
            <div class="row">
                <input type="hidden" name="id" value="0">
                <div class="form-group col-md-5"></div>
                <div class="form-group col-md-7">
                        <input type="submit" value="SUBMIT" class="btn btn-primary"
                          style="border-radius: 6px;" />
                      </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

<script>
    $(document).ready(function () {
      $("#myBtn").click(function () {
        $("#myModal").modal();
      });
    });
  </script>

