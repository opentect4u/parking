<div class="location-banner d-flex justify-content-between align-items-center px-4 py-3 rounded-4 shadow-sm">
  <h4 class="text-light fw-bold mb-0">🌍 <b>Select Your Location</b></h4>

 <!-- Current Date & Time -->
  <div class="text-light fw-bold d-flex gap-3 align-items-center" style="font-weight: 500;">
    <span>🗓️ <span id="currentDate"></span></span>&nbsp; |  &nbsp;
    <span>⏰ <span id="currentTime"></span></span>
  </div>

  <div class="dropdown">
    <!-- Button -->
    <button class="dropdown-btn" id="dropdownBtn">🌍 Choose location...</button>

    <!-- Dropdown Menu -->
    <div class="dropdown-menu" id="dropdownMenu">
      <% if (data && data.msg && data.msg.length > 0) { %>
        <% data.msg.forEach(dt => { %>
          <div class="dropdown-item" data-value="<%= dt.location_id %>">
            📍 <%= dt.loction %>
          </div>
        <% }) %>
      <% } else { %>
        <div class="dropdown-item disabled">No locations available</div>
      <% } %>
    </div>
  </div>
</div>

