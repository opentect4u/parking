<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="titleSec">
                        <button type="button" class="btn btn-primary" id="myBtn"
                          style="float: inline-end;border-radius: 6px;width: 6vw;">Add</button>
                      </div>
                    <h3 class="card-title"><i data-feather="map-pin" class="feather-icon text-dark"></i>  Locations</h3>
                    <div class="table-responsive mt-4">
                        <table id="dataTable" class="table table-striped table-bordered no-wrap">
                            <thead>
                                <tr>
                                    <th class="text-center text-dark">Sl No.</th>
                                    <th class="text-center text-dark">Location Name</th>
                                    <th class="text-center text-dark">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(data.msg && data.msg.length> 0) { %>
                                    <% data.msg.forEach(function(item,index) { %>
                                      <tr>
                                        <td class="text-center text-dark">
                                          <%=(index+1)%>
                                        </td>
                                        <td class="text-center text-dark">
                                          <%=item.loction %>
                                        </td>
                                        <td class="text-center text-dark">
                                          <a href="edit_location?id=<%= item.location_id %>"
                                            class="btn btn-info" style="border-radius: 5px;"><i class="fa fa-edit"></i></a>
                                        </td>
                                      </tr>
                                      <% }); %>
                                        <% } else { %>
                                          <tr>
                                            <td colspan="3" class="text-danger text-center">No data available</td>
                                          </tr>
                                          <% } %>
                               
                            </tbody>
                            <tfoot>
                               
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="myModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <h3 class="modal-title text-dark"><i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Location</b>
          </h3>
          <button type="button" class="close" data-dismiss="modal">
            &times;
          </button>
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/superadmin/location_save" method="post" id="myForm">
            <div class="row">
  
              <div class="col-md-12">
                <div class="form-group">
                  <label for="loc_name" class="text-dark"><b>Location Name</b></label>
                  <textarea class="form-control" rows="3" id="loc_name" name="loc_name" placeholder="Enter Location here....."></textarea>
                </div>
              </div>
            </div>
            <div class="row">
                <input type="hidden" name="id" value="0">
                <div class="form-group col-md-5"></div>
                <div class="form-group col-md-7">
                        <input type="submit" value="SUBMIT" class="btn btn-primary"
                          style="border-radius: 6px;" />
                      </div>
                
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

<script>
    $(document).ready(function () {
      $("#myBtn").click(function () {
        $("#myModal").modal();
      });
    });
  </script>