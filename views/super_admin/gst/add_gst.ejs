<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="card shadow-lg rounded-4 border-0">
        <div class="card-body">
        <!-- <div class="titleSec">
          <button type="button" class="btn btn-primary" id="myBtn"
            style="float: inline-end;border-radius: 6px;width: 6vw;cursor: pointer;">Add</button>
        </div> -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="card-title mb-0 text-gradient fw-bold">
            <i data-feather="tag" class="feather-icon text-dark"></i>&nbsp;<b>GST</b>
          </h3>
          <button type="button" class="btn btn-gradient" id="myBtn">
              <i class="fa fa-plus"></i> Add
            </button>
        </div>

        <!-- <div class="row"> -->
          <!-- <div class="col-md-12"> -->

            <div class="table-responsive mt-3">
              <table id="dataTable" class="table table-bordered align-middle table-striped shadow-sm">
                  <thead class="table-light text-center custom-header">
                      <tr>
                          <th class="text-center text-dark">Sl No.</th>
                          <th class="text-center text-dark">Location Name</th>
                          <th class="text-center text-dark">GST No.</th>
                          <th class="text-center text-dark">MIS Charges</th>
                          <th class="text-center text-dark">GST Flag</th>
                          <th class="text-center text-dark">Action</th>
                      </tr>
                  </thead>
                  <tbody>
                    <% if(data.msg && data.msg.length> 0) { %>
                      <% data.msg.forEach(function(item,index) { %>
                        <% if (user.userData.user_type === 'S' || (user.userData.user_type === 'A' && item.customer_id == user.userData.customer_id)) { %>
                        <tr>
                          <td class="text-center text-dark">
                            <%=(index+1)%>
                          </td>
                          <td class="text-center text-dark">
                            <%=item.customer_name %>
                          </td>
                          <td class="text-center text-dark">
                            <%=item.gst_number %>
                          </td>
                          <td class="text-center text-dark">
                            <%=item.other_charges %>
                          </td>
                          <td class="text-center text-dark">
                            <span class="<%=(item.gst_flag=='Y')?'badge badge-success':'badge badge-danger'%>"
                              style="font-size: 16px;">
                              <%=(item.gst_flag=='Y')?"Active":"Deactive"%>
                            </span>
                          </td>
                          <td class="text-center text-dark">
                            <a href='edit_gst?id=<%= item.gst_id %>&customer_id=<%= (user.userData.user_type == "A" ? user.userData.customer_id : item.customer_id) %>'
                              class="btn btn-info" style="border-radius: 5px;"><i class="fa fa-edit"></i></a>
                          </td>
                        </tr>
                        <% } %>
                        <% }); %>
                          <% } else { %>
                            <tr>
                              <td colspan="6" class="text-danger text-center">No data available</td>
                            </tr>
                            <% } %>
                 
                  </tbody>
                  <tfoot></tfoot>
              </table>
            </div>
            <!-- </div> -->
          <!-- </div> -->
        </div>
      </div>
    </div>
  </div>
</div>


  <link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css"
    rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>

  
  <div class="modal fade" id="myModal">
    <div class="modal-dialog modal-dialog-centered modal-lg-custom">
      <div class="modal-content rounded-4 shadow-lg border-0 glass-bgt">
        <!-- Modal Header -->
        <div class="modal-header border-0">
          <h3 class="modal-title fw-bold text-dark">
            <i data-feather="user-plus" class="feather-icon"></i>&nbsp;&nbsp;<b>Add
              GST</b>
          </h3>
          <!-- <button type="button" class="close" data-dismiss="modal">
            &times;
          </button> -->
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/superadmin/gst_save" method="post" id="myForm">
            <div class = "row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="cust_name" class="text-dark"><b>Location Name</b></label>
                        <% if (user.userData.user_type === 'S') { %>
                        <select name="cust_name" class="form-control" id="cust_name">
                            <option value="">Select Location Name</option>
                            <% customer.forEach(dt => { %>
                              <option value="<%= dt.customer_id %>"><%= dt.customer_name %></option>
                              <% }) %>
                              </select>
                        <% } else { %>
                  <!-- Auto-select & show location name for others (e.g. A) -->
                <% 
                  let selectedCust = customer.find(c => c.customer_id == user.userData.customer_id);
                %>
                <input type="hidden" name="cust_name" value="<%= user.userData.customer_id %>">
                <input type="text" class="form-control" value="<%= selectedCust ? selectedCust.customer_name : '' %>" disabled>
              <% } %>
                    </div>
                </div>
            <!-- </div> -->
            <!-- <div class="row"> -->
              <div class="col-md-6">
                <div class="form-group">
                <label for="gst_num" class="text-dark"><b>GST Number:</b></label>
                <input type="text" class="form-control" name="gst_num" id="gst_num" value=""
                  placeholder="Enter GST Number">
                  </div>
              </div>

              <div class="col-md-6">
                <div class="form-group">
                <label for="total_gst" class="text-dark"><b>Total GST:</b></label>
                <select name="total_gst" class="form-control" id="total_gst">
                  <option value="">Select Total GST</option>
                  <option value="0">0%</option>
                  <option value="5">5%</option>
                  <option value="12">12%</option>
                  <option value="18">18%</option>
                  <option value="28">28%</option>
                </select>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-group">
                <label for="cgst" class="text-dark"><b>CGST:</b></label>
                <!-- <input type="text" class="form-control" name="cgst" id="cgst" value="" placeholder="Enter CGST" readonly> -->
                 <input type="text" class="form-control" id="cgst_display" value="" placeholder="Enter CGST" readonly>
                 <input type="hidden" name="cgst" id="cgst">
              </div>
              </div>
  
              <div class="col-md-6">
                <div class="form-group">
                <label for="sgst" class="text-dark"><b>SGST:</b></label>
                <!-- <input type="text" class="form-control" name="sgst" id="sgst" value="" placeholder="Enter SGST" readonly> -->
                 <input type="text" class="form-control" id="sgst_display" value="" placeholder="Enter SGST" readonly>
                 <input type="hidden" name="sgst" id="sgst">
              </div>
            </div>
             <div class="col-md-6">
                <div class="form-group">
                <label for="other_charges" class="text-dark"><b>Miscellaneous Charges:</b></label>
                <!-- <input type="text" class="form-control" name="sgst" id="sgst" value="" placeholder="Enter SGST" readonly> -->
                 <input type="text" class="form-control" id="other_charges"  name="other_charges" value="" placeholder="Enter Miscellaneous Charges">
              </div>
            </div>
            </div>

            <div class="row mt-3">
              <div class="form-group col-md-5"></div>
              <div class="form-group col-md-0">
                <!-- <input type="submit" value="SUBMIT" class="btn btn-primary"
                  style="margin-left: 32vw;border-radius: 5px;" /> -->
                  <input type="submit" value="SUBMIT" id="submitBtn" class="btn btn-primary" style="border-radius: 6px; background: linear-gradient(135deg, #c172a9, #7799d8)"/>
              </div>
            </div>
          </form>
        </div>
  
      </div>
    </div>
  </div>
  

  <script>
    $(document).ready(function () {
      $("#myBtn").click(function () {
        $("#myModal").modal();
      });
    });
  </script>

