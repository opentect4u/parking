<div class="container-fluid">
    <div class="col-sm-12 col-md-12 col-lg-12">
      <div class="card">
        <div class="card-body">
          <div class="titleSec">
            <button type="button" class="btn btn-primary" id="myBtn"
              style="float: inline-end;border-radius: 6px;width: 6vw;cursor: pointer;">Add</button>
          </div>
          <div class="row mt-4">
            <h3 class="text-dark"><i class="fas fa-ellipsis-h text-dark"></i>&nbsp;<b>Vehicle Rate</b>
            </h3>
          </div>
          <form action="/superadmin/vehicle_rate" method="post">
            <div class="row mt-4">
              <div class="form-group col-md-4">
                <label for="cust_name_sel"><b style="color: black;">Customer Name:</b></label>
                <select name="cust_name" class="form-control" id="cust_name_sel" required>
                  <option value="">Select Customer Name</option>
                  <% customer.forEach(dt => {
                    var _selected = ''
                    if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                    <option value="<%= dt.customer_id %>" <%= _selected %>><%= dt.customer_name %></option>
                    <% }) %>
                </select>
              </div>
              <div class="form-group col-md-4">
                <label for="rate_type_name"><b style="color: black;">Rate Type:</b></label>
                <select name="rate_type_name" class="form-control" id="rate_type_name" disabled>
                  <option value="">Select Rate Type</option>
                  
                </select>
                <input type="hidden" name="rate_type" value="">
              </div>
              <div class="form-group col-md-4">
                <label for="veh_id_sel"><b style="color: black;">Vehicle Name:</b></label>
                <select name="veh_id" class="form-control" id="veh_id_sel" required>
                  <option value="">Select Vehicle Name</option>
                  
                </select>
              </div>
            </div>
            <div class="row mt-2">
              <button type="submit" class="btn btn-primary" style="border-radius: 5px;margin-left: 31vw;" id="submitBtn">Submit</button>
            </div>
          </form>
          <% if(selected.cust_id > 0){ %>
            <div class="row" id="">
              <div class="col-md-12">
                <div class="table-responsive mt-3">
                  <table id="dataTable" class="table table-striped table-bordered no-wrap show_data">
                      <thead>
                          <tr>
                              <th class="text-center text-dark">Sl No.</th>
                              <th class="text-center text-dark">From Hour</th>
                              <th class="text-center text-dark">To Hour</th>
                              <th class="text-center text-dark">Parking Fee</th>
                              <th class="text-center text-dark">Action</th>
                          </tr>
                      </thead>
                      <tbody>
                        <% if(data.length > 0){
                          var i = 1
                          data.forEach(dt => { %>
                            <tr>
                              <td class="text-center text-dark"><%= i %></td>
                              <td class="text-center text-dark"><%= dt.from_hour %></td>
                              <td class="text-center text-dark"><%= dt.to_hour %></td>
                              <td class="text-center text-dark"><%= dt.vehicle_rate %></td>
                              <td class="text-center text-dark"><a href='/superadmin/edit_vehicle?customer_id=<%= selected.cust_id %>&id=<%= dt.vehicle_id %>' class='btn btn-info' style='border-radius:5px'><i class='fa fa-edit'></i></a></td>
                            </tr>
                        <% i++; })
                        }else{ %>
                          <tr>
                            <td class="text-center text-danger" colspan="5">No data found</td>
                          </tr>
                        <% } %>
                      </tbody>
                      <tfoot>
                         
                      </tfoot>
                  </table>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="myModal">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <h3 class="modal-title text-dark"><i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Vehicle
              Rate</b>
          </h3>
          <button type="button" class="close" data-dismiss="modal">
            &times;
          </button>
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/superadmin/vehicle_rate_save" method="post" id="myForm">
            <div class="row">
  
              <div class="form-group col-md-4">
                <label for="sell_id" class="text-dark"><b>Seller Name:</b></label>
                <select name="sell_id" class="form-control" id="sell_id">
                  <option value="">Select Seller Name</option>
                  <% seller.forEach(dt=> { %>
                    <option value="<%= dt.seller_id %>">
                      <%= dt.seller_name %>
                    </option>
                    <% }) %>
                </select>
              </div>
              <div class="form-group col-md-4">
                <label for="cust_name" class="text-dark"><b>Customer Name:</b></label>
                <select name="cust_name" class="form-control" id="cust_name">
                  <option value="">Select Customer Name</option>
                  <% customer.forEach(dt=> { %>
                    <option value="<%= dt.customer_id %>">
                      <%= dt.customer_name %>
                    </option>
                    <% }) %>
                </select>
              </div>
  
              <div class="col-md-4">
                <div class="form-group">
                  <label for="rate_type"><b style="color: black;">Rate Type:</b></label>
                  <select name="rate_type" class="form-control" id="rate_type" required>
                    <option value="">Select Rate Type</option>
                    <option value="H">Hourly</option>
                    <option value="F">Fixed</option>
                  </select>
                </div>
              </div>
  
  
              <div class="form-group col-md-4">
                <label for="veh_id"><b style="color: black;">Vehicle Name:</b></label>
                <select name="veh_id" class="form-control" id="veh_id" required>
                  <option value="">Select Vehicle Name</option>
                  <% vehicle.forEach(dt=> { %>
                    <option value="<%= dt.vehicle_id %>">
                      <%= dt.vehicle_name %>
                    </option>
                    <% }) %>
                </select>
              </div>
  
              <div class="col-md-4">
                <div class="form-group">
                  <label for="frm_hr" class="text-dark"><b>From Hour</b></label>
                  <input type="number" max="24" min="0" class="form-control" id="frm_hr" name="frm_hr" value="00">
                </div>
              </div>
  
              <div class="col-md-4">
                <div class="form-group">
                  <label for="to_hr" class="text-dark"><b>To Hour</b></label>
                  <input type="number" max="24" min="0" class="form-control" id="to_hr" name="to_hr" value="00">
                </div>
              </div>
  
              <div class="col-md-4">
                <div class="form-group">
                  <label for="park_fee" class="text-dark"><b>Parking Fee</b></label>
                  <input type="text" class="form-control" id="park_fee" name="park_fee"
                    placeholder="Enter Parking Fee...." required>
                </div>
              </div>
  
            </div>
            <input type="hidden" name="id" value="0">
            <div class="row mt-3">
              <div class="form-group col-md-3">
                <input type="submit" value="SUBMIT" class="btn btn-primary "
                  style="margin-left: 38vw;border-radius: 6px;" />
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  
  <script>
    $(document).ready(function () {
      $('#cust_name_sel').change()
      $("#myBtn").click(function () {
        $("#myModal").modal();
        // $("#myBtn").hide()
      });
    });
  </script>

  <script>
    var cust_list = <%- JSON.stringify(customer) %>;
    var rate_type = [{id: 'D', name: 'Hourly'}, {id: 'F', name: 'Fixed'}]
    $('#cust_name_sel').on('change', function(){
      console.log('here lalalalal');
      var cust_id = $(this).val()
      changeProcess(cust_id)
    })

    $(document).ready(function(){
      var sel_cust_id = '<%= selected.cust_id %>'
      if(sel_cust_id > 0){
      console.log(sel_cust_id, 'dsasda');
      changeProcess(sel_cust_id)
        // $('#cust_name_sel').change()
      }
    })

    function changeProcess(cust_id){
      var cust_dtls = cust_list.filter(dt => dt.customer_id == cust_id);
      $('#rate_type_name').empty()
      if(cust_dtls.length > 0){
        $('#rate_type_name').append($('<option>', {value: '', text: 'Select Rate Type'}))
        $.each(rate_type, function(i, dt){
          var selected = false
          if(cust_dtls[0].dev_mod == dt.id) selected = true
          $('#rate_type_name').append($('<option>', {value: dt.id, text: dt.name, selected: selected}))
        })
        $('#rate_type').val(cust_dtls[0].dev_mod)
      }else{
        alert('Please select dev mode in customer first')
      }
     
      // $('#cust_name').change(function () {
      //   var cust_id = $(this).val()
      //   var veh_id = $(this).val()

    $.ajax({
      type: "POST",
      url: "/superadmin/vehicle_dt",
      data: { cust_id: cust_id},
      success: function (response) {
        // console.log(response.SUCCESS.branchData.msg)
        $('#veh_id_sel').empty();
        $('#veh_id_sel').append(`<option value="">Select Vehicle Name</option>`)

        var sel_veh_id = '<%= selected.veh_id > 0 ? selected.veh_id : 0 %>'
        response.SUCCESS.veh_id.msg.forEach(function (resData) {
          var _selected = false
          if(sel_veh_id == resData.vehicle_id) _selected = true
          $('#veh_id_sel').append($('<option>', {value: resData.vehicle_id, text: resData.vehicle_name, selected: _selected}))
          // $('#veh_id').append('<option value="' + resData.vehicle_id + '">' + resData.vehicle_id + '</option>');
        });

      },
      error: function (error) {
        console.log(error);
        //   tbody.empty();
      },
    });
    }
  </script>
