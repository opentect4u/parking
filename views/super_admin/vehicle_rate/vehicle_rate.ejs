<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card shadow-lg rounded-4 border-0 p-3" style="border-radius: 20px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="card-title mb-0 text-gradient fw-bold">
            <i class="fas fa-ellipsis-h text-dark"></i>&nbsp;<b>Vehicle Rate</b>
          </h3>
          <button type="button" class="btn btn-gradient" id="myBtn">
            <i class="fa fa-plus"></i> Add
          </button>
        </div>

       <form action="/superadmin/vehicle_rate" method="post">
  <div class="row g-3 align-items-end">
 <div class="col-md-4">
  <label for="cust_name_sel"><b style="color: black;">Location Name:</b></label>
  <select name="cust_name" class="gorgeous-select" id="cust_name_sel" required>
    <option value="">Select Location Name</option>
    <% customer.forEach(dt=> {
      var _selected = ''
      if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
      <option value="<%= dt.customer_id %>" <%=_selected %>><%= dt.customer_name %></option>
    <% }) %>
  </select>
</div>

<div class="col-md-4">
  <label for="veh_id_sel"><b style="color: black;">Vehicle Name:</b></label>
  <select name="veh_id" class="gorgeous-select" id="veh_id_sel" required>
    <option value="">Select Vehicle Name</option>
  </select>
</div>


    <div class="col-md-4 d-flex align-items-end">
      <button type="submit" class="btn btn-gradient ms-3" id="submitBtn">
        <i class="fa fa-search"></i> Search
      </button>
    </div>
  </div>
</form>

        <% if(selected.cust_id>0){ %>
          <div class="table-responsive mt-4">
            <table id="dataTable" class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
              <thead class="custom-header text-center">
                <tr>
                  <th class="text-center text-dark">Sl No.</th>
                  <th class="text-center text-dark">Parking Fee</th>
                  <th class="text-center text-dark">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if(data.length> 0){
                  var i = 1
                  data.forEach(dt => { %>
                  <tr>
                    <td class="text-center text-dark"><%= i %></td>
                    <td class="text-center text-dark"><%= dt.vehicle_rate %></td>
                    <td class="text-center text-dark">
                      <a href='/superadmin/vehicle_edit_rate?customer_id=<%= selected.cust_id %>&id=<%= dt.sl_no %>' class='btn btn-info' style='border-radius:5px'>
                        <i class='fa fa-edit'></i>
                      </a>
                    </td>
                  </tr>
                  <% i++; }) 
                } else { %>
                  <tr>
                    <td class="text-center text-danger" colspan="3">No data found</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>



<div class="modal fade" id="myModal">
  <div class="modal-dialog modal-dialog-centered modal-lg-custom">
    <div class="modal-content rounded-4 shadow-lg glass-bg border-0">
      <!-- Modal Header -->
      <div class="modal-header border-0">
        <h3 class="modal-title fw-bold text-dark">
          <i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Vehicle
            Rate</b>
        </h3>
        <!-- <button type="button" class="close" data-dismiss="modal">
          &times;
        </button> -->
      </div>

      <%- include('./vehicle_rate_modal', {seller, customer}) %>
      
    </div>
  </div>
</div>

