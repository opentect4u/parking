$(document).ready(function(){
  $('#dataTable').DataTable(); // Initialize DataTable
});
</script> -->

<script>
  $(document).ready(function () {
    $('#cust_name_sel').change()
    $("#myBtn").click(function () {
      $("#myModal").modal();
      // $("#myBtn").hide()
    });
  });
</script>

<script>
  var cust_list = <%- JSON.stringify(customer) %>;
  var rate_type = [{ id: 'D', name: 'Hourly' }, { id: 'F', name: 'Fixed' }]
  $('#cust_name_sel').on('change', function () {
    // console.log('here lalalalal');
    var cust_id = $(this).val()
    changeProcess(cust_id)
  })

  $(document).ready(function () {
    var sel_cust_id = '<%= selected.cust_id %>'
    if (sel_cust_id > 0) {
      // console.log(sel_cust_id, 'dsasda');
      changeProcess(sel_cust_id)
      // $('#cust_name_sel').change()
    }
  })

  function changeProcess(cust_id) {
    var cust_dtls = cust_list.filter(dt => dt.customer_id == cust_id);
    $('#rate_type_name').empty()
    if (cust_dtls.length > 0) {
      $('#rate_type_name').append($('<option>', { value: '', text: 'Select Rate Type' }))
      $.each(rate_type, function (i, dt) {
        var selected = false
        if (cust_dtls[0].dev_mod == dt.id) selected = true
        $('#rate_type_name').append($('<option>', { value: dt.id, text: dt.name, selected: selected }))
      })
      $('#rate_type').val(cust_dtls[0].dev_mod)
    } else {
      alert('Please select dev mode in customer first')
    }

    // $('#cust_name').change(function () {
    //   var cust_id = $(this).val()
    //   var veh_id = $(this).val()

    $.ajax({
      type: "POST",
      url: "/superadmin/vehicle_dt",
      data: { cust_id: cust_id },
      success: function (response) {
        // console.log(response.SUCCESS.branchData.msg)
        $('#veh_id_sel').empty();
        $('#veh_id_sel').append(`<option value="">Select Vehicle Name</option>`)

        var sel_veh_id = '<%= selected.veh_id > 0 ? selected.veh_id : 0 %>'
        
        response.SUCCESS.veh_id.msg.forEach(function (resData) {
          var _selected = false
          if (sel_veh_id == resData.vehicle_id) _selected = true
          $('#veh_id_sel').append($('<option>', { value: resData.vehicle_id, text: resData.vehicle_name, selected: _selected }))
          // $('#veh_id').append('<option value="' + resData.vehicle_id + '">' + resData.vehicle_id + '</option>');
        });

      },
      error: function (error) {
        console.log(error);
        //   tbody.empty();
      },
    });
  }
</script>

