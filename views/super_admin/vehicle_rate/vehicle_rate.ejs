$(document).ready(function(){
  $('#dataTable').DataTable(); // Initialize DataTable
});
</script> -->

<script>
  $(document).ready(function () {
    $('#cust_name_sel').change()
    $("#myBtn").click(function () {
      $("#myModal").modal();
      // $("#myBtn").hide()
    });
  });
</script>

<script>
  var cust_list = <%- JSON.stringify(customer) %>;
  var rate_type = [{ id: 'D', name: 'Hourly' }, { id: 'F', name: 'Fixed' }]
  $('#cust_name_sel').on('change', function () {
    // console.log('here lalalalal');
    var cust_id = $(this).val()
    changeProcess(cust_id)
  })

  $(document).ready(function () {
    var sel_cust_id = '<%= selected.cust_id %>'
    if (sel_cust_id > 0) {
      // console.log(sel_cust_id, 'dsasda');
      changeProcess(sel_cust_id)
      // $('#cust_name_sel').change()
    }
  })

  function changeProcess(cust_id) {
    var cust_dtls = cust_list.filter(dt => dt.customer_id == cust_id);
    $('#rate_type_name').empty()
    if (cust_dtls.length > 0) {
      $('#rate_type_name').append($('<option>', { value: '', text: 'Select Rate Type' }))
      $.each(rate_type, function (i, dt) {
        var selected = false
        if (cust_dtls[0].dev_mod == dt.id) selected = true
        $('#rate_type_name').append($('<option>', { value: dt.id, text: dt.name, selected: selected }))
      })
      $('#rate_type').val(cust_dtls[0].dev_mod)
    } else {
      alert('Please select dev mode in customer first')
    }

    // $('#cust_name').change(function () {
    //   var cust_id = $(this).val()
    //   var veh_id = $(this).val()

    $.ajax({
      type: "POST",
      url: "/superadmin/vehicle_dt",
      data: { cust_id: cust_id },
      success: function (response) {
        // console.log(response.SUCCESS.branchData.msg)
        $('#veh_id_sel').empty();
        $('#veh_id_sel').append(`<option value="">Select Vehicle Name</option>`)

        var sel_veh_id = '<%= selected.veh_id > 0 ? selected.veh_id : 0 %>'
        
        response.SUCCESS.veh_id.msg.forEach(function (resData) {
          var _selected = false
          if (sel_veh_id == resData.vehicle_id) _selected = true
          $('#veh_id_sel').append($('<option>', { value: resData.vehicle_id, text: resData.vehicle_name, selected: _selected }))
          // $('#veh_id').append('<option value="' + resData.vehicle_id + '">' + resData.vehicle_id + '</option>');
        });

      },
      error: function (error) {
        console.log(error);
        //   tbody.empty();
      },
    });
  }
</script>

<style>
  .modal-lg-custom {
  max-width: 60%;  /* Increase width as needed */
}

@media (max-width: 1200px) {
  .modal-lg-custom {
    max-width: 90%; /* Responsive for smaller screens */
  }
}

  /* Gorgeous Gradient Select */
.gorgeous-select {
  width: 100%;
  padding: 10px 15px;
  border-radius: 12px;
  border: none;
  font-size: 14px;
  color: #1b1414;
  background: linear-gradient(90deg, #8e2de2, #4a00e0); /* Purple gradient */
  appearance: none; /* Remove default arrow */
  -webkit-appearance: none;
  -moz-appearance: none;
  cursor: pointer;
  box-shadow: 0 4px 8px rgba(0,0,0,0.15);
  transition: 0.3s;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 140 140' xmlns='http://www.w3.org/2000/svg'%3E%3Cpolygon points='0,0 140,0 70,70' fill='%23fff'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 15px center;
  background-size: 12px;
}

.gorgeous-select:hover {
  box-shadow: 0 6px 12px rgba(0,0,0,0.25);
}

.gorgeous-select:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(142, 45, 226, 0.5);
}

.gorgeous-select option {
  color: #000; /* Options text color */
  background: #fff; /* Options background */
}

  .card {
  border-radius: 20px; /* Make whole card rounded */
  overflow: hidden;
}

.btn-gradient {
  background: linear-gradient(45deg, #dbbcda, #6d83e2);
  color: #fff;
  font-weight: 400;
  border: none;
  padding: 10px 20px;
  border-radius: 30px;
}

#dataTable thead th {
  background: linear-gradient(45deg, #dbbcda, #6d83e2);
  color: #fff;
}

#dataTable tbody tr:hover {
  background-color: rgba(106, 17, 203, 0.08) !important;
  transition: 0.3s;
}

</style>