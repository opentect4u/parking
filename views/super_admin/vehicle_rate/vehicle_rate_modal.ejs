 <script>
  $(document).ready(function () {
    // Fetch all customers when page loads
    $.ajax({
      type: "POST",
      url: "/superadmin/cust_list_ajax",
      data: {}, // no seller id now
      success: function (response) {
        $('#cust_name').empty();
        $('#cust_name').append(`<option value="">Select Location Name</option>`);

        response.msg.forEach(function (resData) {
          $('#cust_name').append(
            $('<option>', { value: resData.customer_id, text: resData.customer_name })
          );
        });
      },
      error: function (error) {
        console.log(error);
      },
    });
  });
</script>

