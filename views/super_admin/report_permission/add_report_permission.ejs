<script>
$(document).ready(function () {
    // Selected values from server
    var cust_name = "<%= selected.cust_id || '' %>";
    var sel_admin_id = "<%= selected.admin_name || '' %>";

    // If location is selected, populate admin dropdown
    if(cust_name) {
        change_cust(cust_name, sel_admin_id);
    }

    // On location change
    $('#cust_name').on('change', function () {
        var cust_name = $(this).val();
        change_cust(cust_name, ''); // reset admin selection
    });
});

// Updated change_cust
function change_cust(cust_name, selectedAdmin='') {
    $.ajax({
        type: "POST",
        url: "/superadmin/admin_dt",
        data: { cust_name: cust_name },
        success: function (response) {
            $('#admin_id').empty().append(`<option value="">Select Admin</option>`);
            response.SUCCESS.admin_id.msg.forEach(function (resData) {
                // selectedAdmin is compared here to mark the option
                var option = $('<option>', {
                    value: resData.user_id,
                    text: resData.user_name + ' - (' + resData.user_id + ')'
                });
                if(resData.user_id == selectedAdmin){
                    option.prop('selected', true); // mark as selected
                }
                $('#admin_id').append(option);
            });
        },
        error: function (error) {
            console.log(error);
        }
    });
}
</script>

<script>
$(document).ready(function () {
    // Selected values from server
    var cust_name = "<%= selected.cust_id || '' %>";
    var sel_admin_ids = "<%= selected.admin_name || '' %>";

    // If location is selected, populate admin dropdown
    if(cust_name) {
        change_custs(cust_name, sel_admin_ids);
    }

    // On location change
    $('#cust_id').on('change', function () {
        var cust_name = $(this).val();
        change_custs(cust_name, ''); // reset admin selection
    });
});

// Updated change_cust
function change_custs(cust_name, selectedAdmin='') {
    $.ajax({
        type: "POST",
        url: "/superadmin/admin_dt",
        data: { cust_name: cust_name },
        success: function (response) {
            $('#adminId').empty().append(`<option value="">Select Admin</option>`);
            response.SUCCESS.admin_id.msg.forEach(function (resData) {
                // selectedAdmin is compared here to mark the option
                var option = $('<option>', {
                    value: resData.user_id,
                    text: resData.user_name + ' - (' + resData.user_id + ')'
                });
                if(resData.user_id == selectedAdmin){
                    option.prop('selected', true); // mark as selected
                }
                $('#adminId').append(option);
            });
        },
        error: function (error) {
            console.log(error);
        }
    });
}
</script>



