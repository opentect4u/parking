                  <th class="text-center text-dark">VehicleWise Report</th>
                  <th class="text-center text-dark">DeviceWise Report</th>
                  <th class="text-center text-dark">OperatorWise Report</th>
                  <th class="text-center text-dark">ShiftWise Report</th>
                  <th class="text-center text-dark">Summary Report</th>
                  <th class="text-center text-dark">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if(data.length > 0){
                  var i = 1
                  data.forEach(dt => { %>
                  <tr>
                    <td class="text-center text-dark"><%= i %></td>
                     <td class="text-center text-dark">
                        <div class="form-check form-switch d-inline-block">
                          <input 
                            class="form-check-input" 
                            type="checkbox" 
                            id="reportSwitch_<%= dt.sl_no %>" 
                            name="report_on_off" 
                            <%= dt.detail_report == 'Y' ? "checked" : "" %>
                            disabled>
                          <label 
                            class="form-check-label fw-bold <%= dt.detail_report == 'Y' ? 'text-success' : 'text-danger' %>" 
                            for="reportSwitch_<%= dt.sl_no %>">
                            <%= dt.detail_report == 'Y' ? "ON" : "OFF" %>
                          </label>
                        </div>
                    </td>
                     <td class="text-center text-dark">
                        <div class="form-check form-switch d-inline-block">
                          <input 
                            class="form-check-input" 
                            type="checkbox" 
                            id="reportSwitch_<%= dt.sl_no %>" 
                            name="report_on_off" 
                            <%= dt.veh_wise_report == 'Y' ? "checked" : "" %>
                            disabled>
                          <label 
                            class="form-check-label fw-bold <%= dt.veh_wise_report == 'Y' ? 'text-success' : 'text-danger' %>" 
                            for="reportSwitch_<%= dt.sl_no %>">
                            <%= dt.veh_wise_report == 'Y' ? "ON" : "OFF" %>
                          </label>
                        </div>
                    </td>
                    <td class="text-center text-dark">
                        <div class="form-check form-switch d-inline-block">
                          <input 
                            class="form-check-input" 
                            type="checkbox" 
                            id="reportSwitch_<%= dt.sl_no %>" 
                            name="report_on_off" 
                            <%= dt.dev_wise_report == 'Y' ? "checked" : "" %>
                            disabled>
                          <label 
                            class="form-check-label fw-bold <%= dt.dev_wise_report == 'Y' ? 'text-success' : 'text-danger' %>" 
                            for="reportSwitch_<%= dt.sl_no %>">
                            <%= dt.dev_wise_report == 'Y' ? "ON" : "OFF" %>
                          </label>
                        </div>
                    </td>
                    <td class="text-center text-dark">
                        <div class="form-check form-switch d-inline-block">
                          <input 
                            class="form-check-input" 
                            type="checkbox" 
                            id="reportSwitch_<%= dt.sl_no %>" 
                            name="report_on_off" 
                            <%= dt.operate_wise_report == 'Y' ? "checked" : "" %>
                            disabled>
                          <label 
                            class="form-check-label fw-bold <%= dt.operate_wise_report == 'Y' ? 'text-success' : 'text-danger' %>" 
                            for="reportSwitch_<%= dt.sl_no %>">
                            <%= dt.operate_wise_report == 'Y' ? "ON" : "OFF" %>
                          </label>
                        </div>
                    </td>
                    <td class="text-center text-dark">
                        <div class="form-check form-switch d-inline-block">
                          <input 
                            class="form-check-input" 
                            type="checkbox" 
                            id="reportSwitch_<%= dt.sl_no %>" 
                            name="report_on_off" 
                            <%= dt.shift_wise_report == 'Y' ? "checked" : "" %>
                            disabled>
                          <label 
                            class="form-check-label fw-bold <%= dt.shift_wise_report == 'Y' ? 'text-success' : 'text-danger' %>" 
                            for="reportSwitch_<%= dt.sl_no %>">
                            <%= dt.shift_wise_report == 'Y' ? "ON" : "OFF" %>
                          </label>
                        </div>
                    </td>
                    <td class="text-center text-dark">
                        <div class="form-check form-switch d-inline-block">
                          <input 
                            class="form-check-input" 
                            type="checkbox" 
                            id="reportSwitch_<%= dt.sl_no %>" 
                            name="report_on_off" 
                            <%= dt.summary_report == 'Y' ? "checked" : "" %>
                            disabled>
                          <label 
                            class="form-check-label fw-bold <%= dt.summary_report == 'Y' ? 'text-success' : 'text-danger' %>" 
                            for="reportSwitch_<%= dt.sl_no %>">
                            <%= dt.summary_report == 'Y' ? "ON" : "OFF" %>
                          </label>
                        </div>
                    </td>
                    <td class="text-center text-dark">
                      <a href='/superadmin/edit_report_permission?customer_id=<%= selected.cust_id %>&id=<%= dt.sl_no %>&user_id=<%= dt.user_id %>' 
