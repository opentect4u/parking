             <div class="col-md-4 cust-toggle1 mt-3">
              <label for="summary_flag" class="text-dark"><b>Summary Report Flag</b></label><br>
              <input type="checkbox" value="Y" id="summary_flag" data-toggle="toggle" data-onstyle="success"
                data-offstyle="danger" data-on="Active" data-off="Deactive" name="summary_flag">
            </div>
                        
            </div>
            <div class="row">
                <input type="hidden" name="id" value="0">
                <div class="form-group col-md-5"></div>
                <div class="form-group col-md-0">
                        <input type="submit" value="SUBMIT" class="btn btn-primary"
