<script>
  $(document).ready(function () {
    var user_type = "<%= user.userData.user_type %>";
    var sel_cust_id = "<%= selected.cust_id ? selected.cust_id : '' %>";
    var sel_dev_mod = "<%= selected.dev_mod ? selected.dev_mod : '' %>";

    if (user_type === 'A') {
      // ADMIN → location fixed
      var cust_id = "<%= user.userData.customer_id %>";
      $('#cust_id').val(cust_id).prop('disabled', true);

      // auto-fetch & lock mode
      setDevMode(cust_id, true, sel_dev_mod);
    } else {
      // SUPERADMIN → selects location, mode auto-set and locked
      if (sel_cust_id) {
        // Edit case → set location and fetch mode
        $('#cust_id').val(sel_cust_id);
        setDevMode(sel_cust_id, true, sel_dev_mod);
      }

      $('#cust_id').on('change', function () {
        var cust_id = $(this).val();
        if (cust_id) {
          setDevMode(cust_id, true, ''); // auto-set and lock, no preselection
        } else {
          $('#dev_mode').empty().append('<option value="">Select Mode</option>');
        }
      });
    }
  });

  function setDevMode(cust_id, lockDropdown = false, preselectedDevMod = '') {
    $.ajax({
      type: "POST",
      url: "/superadmin/dev_dt",
      data: { cust_id: cust_id },
      success: function (response) {
        console.log("dev_dt response:", response);

        $('#dev_mode').empty();

        if (response.SUCCESS && response.SUCCESS.dev_mod && response.SUCCESS.dev_mod.msg) {
          // Assuming only one mode comes per customer
          var resData = response.SUCCESS.dev_mod.msg[0];
          var text = resData.dev_mod === 'D' ? 'Dual' : 'Fixed';
          var value = resData.dev_mod;

          // If preselectedDevMod exists (edit case), use it instead
          if (preselectedDevMod) value = preselectedDevMod;

          $('#dev_mode').append(
            $('<option>', {
              value: value,
              text: text,
              selected: true
            })
          );
        }

        // Lock dropdown if needed
        $('#dev_mode').prop('disabled', lockDropdown);
      },
      error: function (error) {
        console.log("Error fetching dev_mode:", error);
      }
    });
  }
</script>



