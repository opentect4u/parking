<div class="container-fluid py-4" style="background: #f5f7fa;">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card shadow-sm rounded-4 border-0 full-rounded-card">
        <div class="card-header bg-gradient text-white py-2">
          <h4 class="mb-0">
            <i class="fa fa-arrow-circle-left" aria-hidden="true" id="back" style="cursor: pointer;"></i>
           &nbsp;Edit Location Details
          </h4>
         </div>
 
        <div class="card-body p-3">
        <form action="/superadmin/customer_save" id="myForm" method="post">

          <div class="row g-2">
            <!-- Location Name -->
            <div class="col-md-4">
                <label for="cust_name" class="form-label"><b>Location Name</b></label>
                <input type="text" class="form-control shadow-sm rounded-pill" id="cust_name" name="cust_name" value="<%= data[0].customer_name %>">
             
            </div>

            <!-- Phone -->
            <div class="col-md-4">
              <div class="form-group">
                <label for="phone" class="form-label"><b>Phone No</b></label>
                <input type="text" class="form-control shadow-sm rounded-pill" id="phone" name="phone" value="<%= data[0].mobile_no%>">
              </div>
            </div>

            <!-- No. of Device -->
            <div class="col-md-4">
              <div class="form-group">
                <label for="no_device" class="form-label"><b>No. of Device</b></label>
                <input type="text" class="form-control shadow-sm rounded-pill" id="no_device" name="no_device" value="<%= data[0].no_device%>">
              </div>
            </div>

            <!-- Customer Address -->
            <div class="col-md-12">
              <div class="form-group">
                <label for="cust_add" class="form-label"><b>Customer Address</b></label>
                <textarea class="form-control shadow-sm" rows="3" id="cust_add" name="cust_add"><%= data[0].cust_addr%></textarea>
              </div>
            </div>
          </div>

          <div class="row mt-4 justify-content-center">
            <input type="hidden" name="id" value="<%= id %>">
            <div class="form-group col-md-4 text-center">
             <input
              type="submit"
              value="SUBMIT"
              class="btn btn-gradient btn-block"/>
            </div>
          </div>
        </form>

      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $("#back").click(function () {
      window.location.href = "/superadmin/customer";
    });
  });
</script>

<style>
  .full-rounded-card {
  border-radius: 1.5rem; /* full rounded corners */
  overflow: hidden;      /* ensures header and body follow the rounded corners */
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.full-rounded-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

.card-header.bg-gradient {
  border-radius: 0; /* header will follow parent card radius via overflow:hidden */
}
.btn-gradient {
  background: linear-gradient(45deg, #dbbcda, #5568c0); /* purple to blue */
  color: #fff;
  font-weight: 600;
  border: none;
  transition: 0.3s ease;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  border-radius: 50px; /* makes pill shape */
}

/* .btn-gradient:hover {
  background: linear-gradient(90deg, #2575fc, #6a11cb); 
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
} */

  .form-control:focus, .form-select:focus {
    border-color: #6a11cb;
    box-shadow: 0 0 0 0.15rem rgba(106,17,203,0.25);
  }
  .card-header.bg-gradient {
    background: linear-gradient(45deg, #dbbcda, #6d83e2);
  }
  .custom-select {
  transition: all 0.3s ease;
  border: 2px solid #ccc;
  padding-right: 2.5rem; /* space for icon */
  background-color: #fff;
  appearance: none; /* remove default arrow */
}

.custom-select:focus {
  border-color: #6a11cb;
  box-shadow: 0 0 0 0.15rem rgba(106,17,203,0.25);
  background: linear-gradient(90deg, #f0f4ff, #ffffff);
}

.custom-select:hover {
  border-color: #2575fc;
}

.position-relative select {
  padding-left: 1rem; /* optional, for symmetry */
}

.position-relative i {
  pointer-events: none; /* icon won't block clicking */
  font-size: 0.9rem;
}
.card.rounded-5 {
  border-radius: 1.5rem; /* bigger round corners */
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card.rounded-5:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}
</style>
