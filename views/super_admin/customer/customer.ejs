<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="titleSec">
                        <button type="button" class="btn btn-primary" id="myBtn"
                          style="float: inline-end;border-radius: 6px;width: 6vw;">Add</button>
                      </div>
                    <h3 class="card-title"><i class="fas fa-users text-dark"></i>  Customer</h3>
                    <div class="table-responsive mt-4">
                        <table id="dataTable" class="table table-striped table-bordered no-wrap">
                            <thead>
                                <tr>
                                    <th class="text-center text-dark">Sl No.</th>
                                    <th class="text-center text-dark">Customer Name</th>
                                    <th class="text-center text-dark">Seller Name</th>
                                    <th class="text-center text-dark">Mobile No.</th>
                                    <th class="text-center text-dark">Email</th>
                                    <th class="text-center text-dark">Customer Address</th>
                                    <th class="text-center text-dark">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(data && data.length> 0) { %>
                                    <% data.forEach(function(item,index) { %>
                                      <tr>
                                        <td class="text-center text-dark">
                                          <%=(index+1)%>
                                        </td>
                                        <td class="text-center text-dark">
                                          <%=item.customer_name %>
                                        </td>
                                        <td class="text-center text-dark">
                                            <%=item.seller_name %>
                                          </td>
                                        <td class="text-center text-dark">
                                            <%=item.mobile_no %>
                                          </td>
                                        <td class="text-center text-dark">
                                            <%=item.email %>
                                          </td>
                                        <td class="text-center text-dark">
                                            <%=item.cust_addr %>
                                          </td>    
                                        <td class="text-center text-dark">
                                          <a href="edit_customer?id=<%= item.customer_id %>"
                                            class="btn btn-info" style="border-radius: 5px;"><i class="fa fa-edit"></i></a>
                                        </td>
                                      </tr>
                                      <% }); %>
                                        <% } else { %>
                                          <tr>
                                            <td colspan="7" class="text-danger text-center">No data available</td>
                                          </tr>
                                          <% } %> 
                            </tbody>
                            <tfoot>
                               
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h3 class="modal-title text-dark"><i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Seller</b>
        </h3>
        <button type="button" class="close" data-dismiss="modal">
          &times;
        </button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/superadmin/customer_save" method="post" id="myForm">
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label for="sell_name" class="text-dark"><b>Seller Name</b></label>
                <select name="sell_name" class="form-control" id="sell_name">
                  <option value="">Select Seller Name</option>
                        <% sell.forEach(dt => { %>
                          <option value="<%= dt.seller_id %>"><%= dt.seller_name %></option>
                        <% })%>
                </select>
              </div>
              </div>

              <div class="col-md-6">
                <div class="form-group">
                  <label for="cust_name" class="text-dark"><b>Customer Name</b></label>
                  <input type="text" class="form-control" id="cust_name" name="cust_name" placeholder="Enter Customer Name.....">
                </div>
                </div>

                <div class="col-md-6">
                  <div class="form-group">
                  <label for="loc_name" class="text-dark"><b>Location Name</b></label>
                    <select name="loc_name" class="form-control" id="loc_name">
                      <option value="">Select Location Name</option>
                      <% location.forEach(dt => { %>
                        <option value="<%= dt.location_id %>"><%= dt.loction %></option>
                      <% })%>
                    </select>
                  </div>
                  </div>  

              <div class="col-md-6">
                <div class="form-group">
                  <label for="phone" class="text-dark"><b>Phone No</b></label>
                  <input type="text" class="form-control" id="phone" name="phone" placeholder="Enter Phone No.....">
                </div>
                </div>

              <div class="col-md-6">
                  <div class="form-group">
                    <label for="email" class="text-dark"><b>Email</b></label>
                    <input type="text" class="form-control" id="email" name="email" placeholder="Enter Email.....">
                  </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group">
                    <label for="dev_mode" class="text-dark"><b>Mode</b></label>
                      <select name="dev_mode" class="form-control" id="dev_mode">
                        <option value="">Select Mode</option>
                          <option value="D">Dual</option>
                          <option value="F">Fixed</option>
                      </select>
                    </div>
                    </div>   
                    
                    <div class="col-md-6">
                      <div class="form-group">
                        <label for="no_device" class="text-dark"><b>No. of Device</b></label>
                        <input type="text" class="form-control" id="no_device" name="no_device" placeholder="ex-1,2,3.....">
                      </div>
                      </div>    

                      <div class="col-md-6">
                        <div class="form-group">
                        <label for="cust_type" class="text-dark"><b>Customer Type</b></label>
                          <select name="cust_type" class="form-control" id="cust_type">
                            <option value="">Select Customer Type</option>
                              <option value="P">Parking</option>
                              <option value="T">Toll Plaza</option>
                          </select>
                        </div>
                        </div>   
                 

            <div class="col-md-12">
              <div class="form-group">
                <label for="cust_add" class="text-dark"><b>Customer Address</b></label>
                <textarea class="form-control" rows="3" id="cust_add" name="cust_add" placeholder="Enter Address here....."></textarea>
              </div>
            </div>
          </div>
          <div class="row">
              <input type="hidden" name="id" value="0">
              <div class="form-group col-md-5"></div>
              <div class="form-group col-md-7">
                      <input type="submit" value="SUBMIT" class="btn btn-primary"
                        style="border-radius: 6px;" />
                    </div>
              
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $("#myBtn").click(function () {
      $("#myModal").modal();
    });
  });
</script>
