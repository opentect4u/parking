<link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css"
  rel="stylesheet">
<script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>


<div class="container-fluid">
  <div class="col-sm-12 col-md-12 col-lg-12">
    <div class="card">
      <div class="card-body">
        <h2 class="text-dark"><i class="fa fa-arrow-circle-left" aria-hidden="true" id="back" style="cursor: pointer;">&nbsp;Edit Report Password</i></h2>
        
        <form action="/superadmin/save_report_pass" method="post">
          <div class="row mt-4">
          <div class="col-md-4 cust-toggle1">
            <label for="report_pwd" class="text-dark"><b>Report Password</b></label><br>
            <input type="checkbox" value="Y" id="report_pwd" data-toggle="toggle" data-onstyle="success"
              data-offstyle="danger" data-on="Active" data-off="Deactive" name="report_pwd"
              <%= data[0].report_password_flag != 'N' ? 'checked' : '' %>>
          </div>
          </div>
        <div class="row" id="details">

          <%#  data.msg.forEach(function(dt){%>
            <div class="row mt-3" style="margin-left: 2px;">

              <div class="form-group col-md-12">
                <label for="pwd"><b style="color: black;">Password:</b></label>
                <div class="input-group">
                  <input type="password" id="pwd" name="pwd" class="form-control" value=""
                  oninput="checkInput()" placeholder="Enter password here....." />
                  <div class="input-group-append">
                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                      <i class="fa fa-eye-slash"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>

          <%# }) %>
            
          </div>
          <div class="form-group col-md-12 mt-2">
            <input type="hidden" name="id" value="<%= id %>">
            <input type="hidden" name="cust_id" value="<%= customer_id %>">

            <button type="submit" id="submitButton" class="btn btn-success" style="border-radius: 5px;">Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function checkInput() {
      var pwd = document.getElementById("pwd");
      var submitButton = document.getElementById("submitButton");

      if (pwd.value.trim() !== "") {
          submitButton.disabled = false;
      } else {
          submitButton.disabled = true;
      }
  }
</script>

<script>
  document.getElementById("togglePassword").addEventListener("click", function () {
    const pwdField = document.getElementById("pwd");
    if (pwdField.type === "password") {
      pwdField.type = "text";
    } else {
      pwdField.type = "password";
    }
  });
</script>

<script>
  $('#report_pwd').on('change', function () {
    if ($(this).is(':checked')) {
      $('#details').show()
      if($('#pwd').val().length == 0)
        $('#submitButton').attr('disabled', true)
    } else {
      $('#submitButton').removeAttr('disabled')
      $('#details').hide()
    }
  })
  $(document).ready(function(){
    var chk_flag = "<%= data[0].report_password_flag %>"
    // console.log(chk_flag,'flag');
    if(chk_flag != 'N'){
      $('#details').show()
      console.log($('#pwd').val().length, 'val');
      if($('#pwd').val().length == 0) 
        $('#submitButton').attr('disabled', true)
    }else{
      $('#submitButton').removeAttr('disabled')
      $('#details').hide();
    }
  })
</script>

<script>
    $(document).ready(function () {
      $("#back").click(function () {
        window.location.href = "/superadmin/report_pass";
      });
    });
  </script>



