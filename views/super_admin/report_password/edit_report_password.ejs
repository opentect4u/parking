<link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css"
  rel="stylesheet">
<script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>

<style>
  body {
    background: #f5f7fa;
    font-family: "Segoe UI", sans-serif;
  }

  .card {
    border: none;
    border-radius: 20px;
    box-shadow: 0px 5px 20px rgba(0, 0, 0, 0.15);
    background: #fff;
  }

  .card-header {
    border-radius: 20px 20px 0 0;
    background: linear-gradient(135deg, #a18cd1, #fbc2eb);
    color: #fff;
    font-weight: bold;
    font-size: 18px;
    padding: 12px 20px;
  }

  .form-control {
    border-radius: 12px;
    border: 1px solid #ddd;
    padding: 10px;
    transition: 0.3s;
  }

  .form-control:focus {
    border-color: #6a11cb;
    box-shadow: 0 0 5px rgba(106, 17, 203, 0.4);
  }

  label {
    font-weight: 600;
    margin-bottom: 6px;
    color: #333;
  }

  .btn-submit {
    background: linear-gradient(135deg, #a18cd1, #fbc2eb);
    color: #fff;
    border: none;
    border-radius: 25px;
    padding: 10px 30px;
    font-weight: 600;
    transition: 0.3s;
  }

  .btn-submit:hover {
    transform: scale(1.05);
    background: linear-gradient(135deg, #5a0fbf, #1d5edc);
  }

  .btn-gradient-back {
    background: linear-gradient(135deg, #ff6f00, #ff8f00);
    border: none;
    border-radius: 8px;
    font-weight: 600;
    padding: 8px 18px;
    color: white;
    transition: 0.3s;
    cursor: pointer;
  }

  .btn-gradient-back:hover {
    background: linear-gradient(135deg, #e65100, #ff6f00);
    transform: scale(1.05);
  }
  .toggle.btn {
  min-width: 120px;   /* Wider */
  min-height: 40px;   /* Taller */
  font-size: 15px;    /* Larger text */
  border-radius: 25px !important;
  padding: 6px 12px;
}
.toggle-on.btn {
  background: linear-gradient(135deg, #00c853, #00e676);
  color: #fff;
}
.toggle-off.btn {
  background: linear-gradient(135deg, #ff5252, #ff1744);
  color: #fff;
}
</style>

<div class="container py-5">
  <div class="col-lg-6 mx-auto">
    <div class="card">
      <div class="card-header">
        <i class="fa fa-key"></i> Edit Report Password
      </div>
      <div class="card-body">

        <!-- Back Button -->
        <div class="mb-3">
          <button class="btn-gradient-back" id="back">
            <i class="fa fa-arrow-circle-left"></i> Back
          </button>
        </div>

        <form action="/superadmin/save_report_pass" method="post">
          <div class="mb-3">
            <label for="report_pwd">Report Password</label><br>
            <input type="checkbox" id="report_pwd" data-toggle="toggle" data-onstyle="success"
              data-offstyle="danger" data-on="Active" data-off="Deactive"
              <%= data[0].report_password_flag == 'Y' ? 'checked' : '' %>>
            <input type="hidden" id="report_pwd_hidden" name="report_pwd" value="<%= data[0].report_password_flag == 'Y' ? 'Y' : 'N' %>">
          </div>

          <div id="details">
            <div class="mb-3">
              <label for="pwd">Password</label>
              <div class="input-group">
                <input type="password" id="pwd" name="pwd" class="form-control"
                  placeholder="Enter password here..." oninput="checkInput()" />
                <div class="input-group-append">
                  <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                    <i class="fa fa-eye-slash"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <input type="hidden" name="id" value="<%= id %>">
          <input type="hidden" name="cust_id" value="<%= customer_id %>">

          <div class="text-center">
            <button type="submit" id="submitButton" class="btn-submit">SUBMIT</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function checkInput() {
    var pwd = document.getElementById("pwd");
    var submitButton = document.getElementById("submitButton");
    submitButton.disabled = pwd.value.trim() === "";
  }

  document.getElementById("togglePassword").addEventListener("click", function () {
    const pwdField = document.getElementById("pwd");
    const icon = this.querySelector("i");
    if (pwdField.type === "password") {
      pwdField.type = "text";
      icon.classList.remove("fa-eye-slash");
      icon.classList.add("fa-eye");
    } else {
      pwdField.type = "password";
      icon.classList.remove("fa-eye");
      icon.classList.add("fa-eye-slash");
    }
  });

  $('#report_pwd').on('change', function () {
    if ($(this).is(':checked')) {
      $('#details').show();
      if ($('#pwd').val().length === 0)
        $('#submitButton').attr('disabled', true);
    } else {
      $('#submitButton').removeAttr('disabled');
      $('#details').hide();
    }
  });

  $(document).ready(function () {
    var chk_flag = "<%= data[0].report_password_flag %>";
    if (chk_flag != 'N') {
      $('#details').show();
      if ($('#pwd').val().length === 0)
        $('#submitButton').attr('disabled', true);
    } else {
      $('#submitButton').removeAttr('disabled');
      $('#details').hide();
    }

    $("#back").click(function () {
      window.location.href = "/superadmin/report_pass";
    });
  });
</script>
