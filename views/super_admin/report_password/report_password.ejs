<style>
  .cust-toggle1 .toggle {
      width: 100% !important;
  }
</style>
<div class="container-fluid">
  <div class="col-sm-12 col-md-12 col-lg-12">
    <div class="card">
      <div class="card-body">
        <!-- <div class="titleSec">
          <button type="button" class="btn btn-primary" id="myBtn"
            style="float: inline-end;border-radius: 6px;width: 6vw;cursor: pointer;">Add</button>
        </div> -->
        <div class="row mt-4">
          <h3 class="text-dark"><i data-feather="key" class="feather-icon text-dark"></i>&nbsp;<b>Report Password</b>
          </h3>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div class="table-responsive mt-3">
              <table id="dataTable" class="table table-striped table-bordered no-wrap show_data">
                  <thead>
                      <tr>
                          <th class="text-center text-dark">Sl No.</th>
                          <th class="text-center text-dark">Customer Name</th>
                          <th class="text-center text-dark">Action</th>
                      </tr>
                  </thead>
                  <tbody>
                    <% if(data.msg && data.msg.length> 0) { %>
                      <% data.msg.forEach(function(item,index) { %>
                        <tr>
                          <td class="text-center text-dark">
                            <%=(index+1)%>
                          </td>
                          <td class="text-center text-dark">
                            <%=item.customer_name %>
                          </td>
                          <td class="text-center text-dark">
                            <a href="edit_report_pass?customer_id=<%= item.customer_id %>"
                              class="btn btn-info" style="border-radius: 5px;"><i class="fa fa-edit"></i></a>
                          </td>
                        </tr>
                        <% }); %>
                          <% } else { %>
                            <tr>
                              <td colspan="3" class="text-danger text-center">No data available</td>
                            </tr>
                            <% } %>
                 
                  </tbody>
                  <tfoot>
                     
                  </tfoot>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css"
rel="stylesheet">
<script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>

<div class="modal fade" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h3 class="modal-title text-dark"><i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Report Password</b>
        </h3>
        <button type="button" class="close" data-dismiss="modal">
          &times;
        </button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/superadmin/save_report_pass" method="post" id="myForm">
          <div class="row">
              <div class="form-group col-5">
                  <label for="cust_id" class="text-dark"><b>Customer Name:</b></label>
                  <select name="cust_id" class="form-control" id="cust_id">
                    <option value="">Select Customer Name</option>
                    <select>
                      <% customer.forEach(dt => { %>
                        <option value="<%= dt.customer_id %>"><%= dt.customer_name %></option>
                      <% }) %>
                    </select>
                  </select>
                </div>

                <div class="form-group col-md-2 cust-toggle1">
                  <label for="report_pwd" class="text-dark"><b>Report Password</b></label><br>
                  <input type="checkbox" value="Y" id="report_pwd" data-toggle="toggle" data-onstyle="success"
                    data-offstyle="danger" data-on="Active" data-off="Deactive" name="report_pwd" checked>
                </div>  

                <div class="form-group col-md-5" id="details">
                  <label for="pwd"><b style="color: black;">Password:</b></label>
                  <div class="input-group">
                    <input type="password" id="pwd" name="pwd" class="form-control" value=""
                    oninput="checkInput()" placeholder="Enter password here....." />
                    <div class="input-group-append">
                      <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                        <i class="fa fa-eye-slash"></i>
                      </button>
                    </div>
                  </div>
                </div>
          </div>
          <div class="row">
              <input type="hidden" name="id" value="0">
              <div class="form-group col-md-5"></div>
              <div class="form-group col-md-7">
                      <input type="submit" id="submitButton" value="SUBMIT" class="btn btn-primary"
                        style="border-radius: 6px;" />
                    </div>
              
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $("#myBtn").click(function () {
      $("#myModal").modal();
    });
  });
</script>

<script>
  function checkInput() {
      var pwd = document.getElementById("pwd");
      var submitButton = document.getElementById("submitButton");

      if (pwd.value.trim() !== "") {
          submitButton.disabled = false;
      } else {
          submitButton.disabled = true;
      }
  }
</script>

<script>
  document.getElementById("togglePassword").addEventListener("click", function () {
    const pwdField = document.getElementById("pwd");
    if (pwdField.type === "password") {
      pwdField.type = "text";
    } else {
      pwdField.type = "password";
    }
  });
</script>

<script>
  $('#report_pwd').on('change', function () {
    if ($(this).is(':checked')) {
      $('#details').show()
      if($('#pwd').val().length == 0)
        $('#submitButton').attr('disabled', true)
    } else {
      $('#submitButton').removeAttr('disabled')
      $('#details').hide()
    }
  })
  $(document).ready(function(){
    var chk_flag = "Y"
    if(chk_flag != 'N'){
      $('#details').show()
      console.log($('#pwd').val().length, 'val');
      if($('#pwd').val().length == 0)
        $('#submitButton').attr('disabled', true)
    }else{
      $('#submitButton').removeAttr('disabled')
      $('#details').hide();
    }
  })
</script>