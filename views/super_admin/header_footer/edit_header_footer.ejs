                type="checkbox" 
                value = 1
                id="header_1_flag" 
                data-toggle="toggle" 
                data-onstyle="success" 
                data-offstyle="danger" 
                data-on="Active" 
                data-off="Deactive" 
                name="header_1_flag"
                <%=(data[0].header1_flag=='1')?'checked':''%>
                >
                </div>

