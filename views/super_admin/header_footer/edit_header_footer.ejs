      <div class="card col-12">
        <div class="card-body">
          <div class="titleSec">
             <h2 class="text-dark"><i class="fa fa-arrow-circle-left" aria-hidden="true" id="back" style="cursor: pointer;">&nbsp;Header & Footer Edit Details</i></h2>
          </div> 
          <form action="/superadmin/save_header_footer" id="myForm" method="post">
          <div class="row mt-4">
