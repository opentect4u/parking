<div class="container-fluid">
    <div class="col-sm-12 col-md-12 col-lg-12">
      <div class="card">
        <div class="card-body">
          <div class="titleSec">
            <button type="button" class="btn btn-primary" id="myBtn"
              style="float: inline-end;border-radius: 6px;width: 6vw;cursor: pointer;">Add</button>
          </div>
          <div class="row mt-4">
            <h3 class="text-dark"><i data-feather="user-check" class="feather-icon text-dark"></i>&nbsp;<b>Operator</b>
            </h3>
          </div>
          <form action="/superadmin/operator" method="post">
            <div class="row mt-4">
              <div class="form-group col-md-5">
                <label for="cust_name"><b style="color: black;">Customer Name:</b></label>
                <select name="cust_name" class="form-control" id="cust_name" required>
                  <option value="">Select Customer Name</option>
                  <% customer.forEach(dt => {
                    var _selected = ''
                    if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                      <option value="<%= dt.customer_id %>" <%= _selected %>><%= dt.customer_name %></option>
                    <% })%>
                </select>
              </div>
              <div class="form-group col-md-4" style="margin-top: 30px;">
                <button type="submit" class="btn btn-primary" style="border-radius: 5px;" id="submitBtn">Submit</button>
              </div>
            </div>
          </form>
          <% if(selected.cust_id > 0){ %>
            <div class="row">
              <div class="col-md-12">
                <div class="table-responsive mt-3">
                  <table id="dataTable" class="table table-striped table-bordered no-wrap show_data">
                      <thead>
                          <tr>
                              <th class="text-center text-dark">Sl No.</th>
                              <th class="text-center text-dark">Operator Name</th>
                              <th class="text-center text-dark">User ID</th>
                              <th class="text-center text-dark">Action</th>
                          </tr>
                      </thead>
                      <tbody>
                        <% if(data.length > 0){
                            var i = 1
                            data.forEach(dt => { %>
                              <tr>
                                <td class="text-center text-dark"><%= i %></td>
                                <td class="text-center text-dark"><%= dt.operator_name %></td>
                                <td class="text-center text-dark"><%= dt.user_id %></td>
                                <td class="text-center text-dark"><a href='/superadmin/edit_operator?customer_id=<%= selected.cust_id %>&id=<%= dt.operator_id %>' class='btn btn-info' style='border-radius:5px'><i class='fa fa-edit'></i></a></td>
                              </tr>
                          <% i++; })
                          }else{ %>
                            <tr>
                              <td class="text-center text-danger" colspan="4">No data found</td>
                            </tr>
                          <% } %>
                      </tbody>
                      <tfoot>
                         
                      </tfoot>
                  </table>
                </div>
              </div>
            </div>
            <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="myModal">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <h3 class="modal-title text-dark"><i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Operator</b>
          </h3>
          <button type="button" class="close" data-dismiss="modal">
            &times;
          </button>
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/superadmin/operator_save" method="post" id="myForm">
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                    <label for="cust_name" class="text-dark"><b>Customer Name</b></label>
                    <select name="cust_name" class="form-control" id="cust_name">
                        <option value="">Select Customer Name</option>
                        <% customer.forEach(dt => { %>
                          <option value="<%= dt.customer_id %>"><%= dt.customer_name %></option>
                          <% }) %>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="seller_name" class="text-dark"><b>Seller Name</b></label>
                    <select name="seller_name" class="form-control" id="seller_name">
                        <option value="">Select Seller Name</option>
                        <% seller.forEach(dt => { %>
                          <option value="<%= dt.seller_id %>"><%= dt.seller_name %></option>
                          <% }) %>
                    </select>
                </div>
            </div>
                <div class="col-md-6">
                  <div class="form-group">
                    <label for="op_name" class="text-dark"><b>Operator Name</b></label>
                    <input type="text" class="form-control" id="op_name" name="op_name" placeholder="Enter Operator Name.....">
                  </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="mobile" class="text-dark"><b>Mobile No</b></label>
                      <input type="text" class="form-control" id="mobile" name="mobile" placeholder="Enter Mobile No.....">
                    </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                        <label for="loc_name" class="text-dark"><b>Location Name</b></label>
                          <select name="loc_name" class="form-control" id="loc_name">
                            <option value="">Select Location Name</option>
                            <% location.forEach(dt => { %>
                              <option value="<%= dt.location_id %>"><%= dt.loction %></option>
                            <% })%>
                          </select>
                        </div>
                        </div> 
                        <div class="col-md-6">
                            <div class="form-group">
                              <label for="dev_id" class="text-dark"><b>Device ID</b></label>
                              <input type="text" class="form-control" id="dev_id" name="dev_id" placeholder="Enter Device ID.....">
                            </div>
                            </div>
                            <div class="form-group col-6">
                                <label for="pwd" class="text-dark"><b>Password:</b></label>
                                <div class="input-group">
                                  <input type="password" class="form-control" name="pwd" id="pwd" value="" placeholder="Enter Password">
                                  <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                      <i class="fa fa-eye-slash"></i>
                                    </button>
                                  </div>
                                </div>
                              </div>           
            </div>
            <div class="row">
                <input type="hidden" name="id" value="0">
                <div class="form-group col-md-5"></div>
                <div class="form-group col-md-7">
                        <input type="submit" value="SUBMIT" class="btn btn-primary"
                          style="border-radius: 6px;" />
                      </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

<script>
    $(document).ready(function () {
      $("#myBtn").click(function () {
        $("#myModal").modal();
      });
    });
  </script>

<script>
    document.getElementById("togglePassword").addEventListener("click", function () {
      const pwdField = document.getElementById("pwd");
      if (pwdField.type === "password") {
        pwdField.type = "text";
      } else {
        pwdField.type = "password";
      }
    });
  </script>