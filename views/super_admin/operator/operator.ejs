<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <!-- Card -->
      <div class="card shadow-lg border-0 custom-card" 
           style="border-radius: 20px; background: linear-gradient(145deg, #ffffff, #f0f2f7);">
        
        <!-- Card Header -->
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
          <h4 class="mb-0 text-gradient fw-bold">
            <i class="fa fa-user me-2"></i> Operator
          </h4>
          <button type="button" class="btn btn-gradient px-4 rounded-pill" id="myBtn">
            <i class="fa fa-plus"></i> Add
          </button>
        </div>

        <!-- Search Form -->
        <form action="/superadmin/operator" method="post" class="p-4">
          <div class="row g-3 align-items-end justify-content-center">
            <!-- Dropdown -->
            <div class="col-md-6">
              <label for="cust_name" class="form-label fw-semibold text-dark"><b>Location Name:</b></label>
              <select name="cust_name" class="form-control custom-select shadow-sm" id="cust_name" required>
                <option value="">Select Location Name</option>
                <% customer.forEach(dt => {
                  var _selected = ''
                  if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                  <option value="<%= dt.customer_id %>" <%= _selected %>>
                    <%= dt.customer_name %>
                  </option>
                <% })%>
              </select>
            </div>
            <!-- Submit -->
            <div class="col-md-3 text-center">
              <button type="submit" class="btn btn-gradient w-100 rounded-pill" id="submitBtn">
                <i class="fa fa-search"></i> Submit
              </button>
            </div>
          </div>
        </form>

        <!-- Table -->
        <% if(selected.cust_id > 0){ %>
        <div class="p-3">
          <div class="table-responsive">
            <table id="dataTable" class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
              <thead>
                <tr>
                  <th class="text-center text-dark">Sl No.</th>
                  <th class="text-center text-dark">Operator Name</th>
                  <th class="text-center text-dark">User ID</th>
                  <th class="text-center text-dark">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if(data.length > 0){
                  var i = 1
                  data.forEach(dt => { %>
                  <tr>
                    <td class="text-center text-dark"><%= i %></td>
                    <td class="text-center text-dark"><%= dt.operator_name %></td>
                    <td class="text-center text-dark"><%= dt.user_id %></td>
                    <td class="text-center text-dark">
                      <a href='/superadmin/edit_operator?customer_id=<%= selected.cust_id %>&id=<%= dt.operator_id %>' 
                         class='btn btn-info btn-sm rounded-pill'>
                         <i class='fa fa-edit'></i>
                      </a>
                    </td>
                  </tr>
                <% i++; })
                }else{ %>
                <tr>
                  <td class="text-center text-danger" colspan="4">No data found</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>



  <div class="modal fade" id="myModal">
    <div class="modal-dialog modal-dialog-centered modal-lg-custom">
      <div class="modal-content rounded-4 shadow-lg glass-bg border-0">
        <!-- Modal Header -->
        <div class="modal-header border-0">
          <h3 class="modal-title fw-bold text-dark">
            <i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Operator</b>
          </h3>
          <!-- <button type="button" class="close" data-dismiss="modal">
            &times;
          </button> -->
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/superadmin/operator_save" method="post" id="myForm">
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                    <label for="cust_name" class="text-dark"><b>Location Name</b></label>
                    <select name="cust_name" class="form-control" id="cust_name">
                        <option value="">Select Location Name</option>
                        <% customer.forEach(dt => { %>
                          <option value="<%= dt.customer_id %>"><%= dt.customer_name %></option>
                          <% }) %>
                    </select>
                </div>
            </div>
                <div class="col-md-6">
                  <div class="form-group">
                    <label for="op_name" class="text-dark"><b>Operator Name</b></label>
                    <input type="text" class="form-control" id="op_name" name="op_name" placeholder="Enter Operator Name.....">
                  </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="mobile" class="text-dark"><b>Mobile No</b></label>
                      <input type="text" class="form-control" id="mobile" name="mobile" placeholder="Enter Mobile No.....">
                    </div>
                    </div>
                        <div class="col-md-6">
                            <div class="form-group">
                              <label for="dev_id" class="text-dark"><b>Device ID</b></label>
                              <input type="text" class="form-control" id="dev_id" name="dev_id" placeholder="Enter Device ID.....">
                            </div>
                            </div>
                            <div class="form-group col-6">
                                <label for="pwd" class="text-dark"><b>Password:</b></label>
                                <div class="input-group">
                                  <input type="password" class="form-control" name="pwd" id="pwd" value="" placeholder="Enter Password">
                                  <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                      <i class="fa fa-eye-slash"></i>
                                    </button>
                                  </div>
                                </div>
                              </div>           
            </div>
            <div class="row">
                <input type="hidden" name="id" value="0">
                <div class="col-12 text-center">
    <input type="submit" 
           value="SUBMIT" 
           class="btn btn-primary px-4"
           style="border-radius: 6px;" />
  </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

<script>
    $(document).ready(function () {
      $("#myBtn").click(function () {
        $("#myModal").modal();
      });
    });
  </script>

<script>
    document.getElementById("togglePassword").addEventListener("click", function () {
      const pwdField = document.getElementById("pwd");
      if (pwdField.type === "password") {
        pwdField.type = "text";
      } else {
        pwdField.type = "password";
      }
    });
  </script>

  <style>
/* Gradient Button */
.btn-gradient {
  background: linear-gradient(45deg, #dbbcda, #6d83e2);
  color: rgb(7, 5, 5);
  font-weight: 600;
  border: none;
  padding: 10px 20px;
  border-radius: 30px;
  transition: 0.3s;
}
.btn-gradient:hover {
  transform: scale(1.05);
  box-shadow: 0 5px 15px rgba(0,0,0,0.25);
  color: #fff;
}

/* Gradient Text */
.text-gradient {
  background: linear-gradient(to right, #b983b8, #4355a7);;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Custom Table */
#dataTable thead th {
  background: linear-gradient(45deg, #dbbcda, #6d83e2);
  color: #fff;
  font-weight: 600;
}
#dataTable tbody tr:hover {
  background-color: rgba(106, 17, 203, 0.08) !important;
  transition: 0.3s;
}

/* Glassmorphism Modal */
.glass-bg {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
}

/* Form Controls */
.form-control {
  border-radius: 12px;
  /* padding: 12px; */
}
.custom-select option {
  background: linear-gradient(45deg, #dbbcda, #6d83e2);
  color: #0e0a0a;
}
.modal-lg-custom {
  max-width: 50%;
}
.gradient-select {
  background: linear-gradient(90deg, #8e2de2, #4a00e0); /* Purple gradient */
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 10px 15px;
  font-size: 14px;
  appearance: none; /* removes default arrow */
  -webkit-appearance: none;
  -moz-appearance: none;
  cursor: pointer;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.gradient-select option {
  background: #fff; /* Dropdown list background */
  color: #333;      /* Dropdown list text */
}

.gradient-select:focus {
  outline: none;
  box-shadow: 0 0 0 2px rgba(142, 45, 226, 0.5);
}
.custom-card {
  border-radius: 20px; /* Rounded corners for whole card */
  overflow: hidden; /* Ensure inner elements respect the border-radius */
}
.card.p-0 {
  padding: 0 !important;
}
#cust_name,
#cust_name_modal {
  color: #000 !important; /* Dark text */
}

/* Optional: keep placeholder lighter */
#cust_name option:first-child,
#cust_name_modal option:first-child {
  color: #6c757d; /* light gray for placeholder */
}
</style>