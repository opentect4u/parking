<title>VPark || Sign In</title>

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      /* background: linear-gradient(135deg, #9384a3 0%, #608ad3 100%); */
       background: linear-gradient(135deg, #fbc2eb 0%, #1d4da1 100%);
       /* background: linear-gradient(135deg, #cec8cc 0%, #0946af 100%); */
       /* background: linear-gradient(to right, #7b93af, #113969); */
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Floating background circles */
    body::before, body::after {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      top: -100px;
      left: -100px;
      filter: blur(120px);
      animation: float 10s infinite alternate ease-in-out;
    }
    body::after {
      top: auto;
      bottom: -150px;
      right: -100px;
      left: auto;
      background: rgba(255,255,255,0.07);
      animation-duration: 12s;
    }
    @keyframes float {
      from { transform: translateY(0px); }
      to { transform: translateY(50px); }
    }

    /* .login-container {
      max-width: 850px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 20px;
      backdrop-filter: blur(18px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.3);
      overflow: hidden;
      animation: fadeIn 1.2s ease-in-out;
    } */

    .login-container {
      max-width: 850px;
      background: #fff;              /* ✅ solid white */
      border: 1px solid #ddd;        /* ✅ light border */
      border-radius: 20px;
      box-shadow: 0 15px 35px rgba(0,0,0,0.1); /* softer shadow */
      overflow: hidden;
      animation: fadeIn 1.2s ease-in-out;
      }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .login-container .left-section {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 50px;
    }

    .login-container .left-section img {
      max-width: 180px;
      animation: pop 2s infinite alternate ease-in-out;
    }

    @keyframes pop {
      from { transform: scale(1); }
      to { transform: scale(1.05); }
    }

    .login-container .form-section {
      padding: 60px 45px;
      color: #333;
    }

    /* .form-control {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      padding: 12px 45px;
      color: #fff;
      position: relative;
    }

    .form-control:focus {
      background: rgba(255, 255, 255, 0.25);
