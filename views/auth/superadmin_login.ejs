    .input-icon {
  position: absolute;
  left: 15px;              /* distance from left edge */
  top: 50%;                /* vertical center */
  transform: translateY(-50%);
  color: #6a11cb;          /* purple shade */
  font-size: 18px;         /* icon size */
  pointer-events: none;    /* so clicks go to input */
}


    .form-control {
  background: #f8f9fa;  
  border: none;      /* ✅ light background */
  border: 1px solid #ccc;     /* ✅ visible border */
  border-radius: 12px;
  padding: 12px 45px;
  padding-left: 45px !important; /* make space for icon */
  color: #333;                /* ✅ dark text */
  /* position: relative; */
}

.form-control:focus {
  background: #fff;           /* ✅ solid white on focus */
  border-color: #6a11cb;      /* ✅ purple border on focus */
  box-shadow: 0 0 8px rgba(106, 17, 203, 0.3);
  outline: none;
}

/* .input-group-text {
  background: transparent;
  border: none;
  color: #141212;               
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
} */

.input-group-text {
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  color: #555;    /* ✅ dark gray icon */
  font-size: 18px;
  border: none;
  background: transparent;
  pointer-events: none;
}

    .btn-primary {
      background: linear-gradient(135deg, #b28dda, #618cd6);
      border: none;
      border-radius: 30px;
      padding: 14px;
      font-size: 16px;
      font-weight: 600;
      transition: all 0.3s ease-in-out;
      box-shadow: 0 6px 18px rgba(0,0,0,0.25);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #728ab3, #8b5fb9);
      transform: scale(1.08);
      box-shadow: 0 10px 25px rgba(0,0,0,0.35);
    }

    h3 {
      font-weight: 700;
      margin-bottom: 10px;
    }

    p {
      opacity: 0.9;
      margin-bottom: 25px;
    }
    .logo-img {
  max-width: 200px;
  margin-bottom: 20px;
}

.car-img {
  max-width: 140px;
  animation: floatCar 4s infinite ease-in-out;
}

@keyframes floatCar {
  0%,100% { transform: translateY(0px); }
  50% { transform: translateY(-15px); }
}

 /* ✅ Toast styles */
    #toast {
      visibility: hidden;
      min-width: 250px;
      margin-left: -125px;
      background-color: #333;
      color: #fff;
      text-align: center;
      border-radius: 4px;
      padding: 12px;
      position: fixed;
      z-index: 9999;
      left: 50%;
      bottom: 30px;
      font-size: 14px;
    }

    #toast.show {
      visibility: visible;
      animation: fadein 0.5s, fadeout 0.5s 2.5s;
    }

    @keyframes fadein {
      from {bottom: 0; opacity: 0;} 
      to {bottom: 30px; opacity: 1;}
    }

    @keyframes fadeout {
      from {bottom: 30px; opacity: 1;} 
      to {bottom: 0; opacity: 0;}
    }

  </style>
</head>
<body>

  <div class="container login-container">
    <div class="row g-0">
      <!-- Left: Logo / Animation -->
      <div class="col-md-6 left-section text-center">
        <img src="https://cdn-icons-png.flaticon.com/512/1048/1048313.png" alt="Car" class="car-img"/>
        <img src="/image/VPark logo 2.png" alt="Logo"/>

      </div>

      <!-- <div class="col-md-6 left-section text-center">
  <div class="logo-container">
     <img src="/image/VPark logo 2.png" 
         alt="V Park Logo" class="logo-img"/>
    <img src="https://cdn-icons-png.flaticon.com/512/1048/1048313.png" 
         alt="Car" class="car-img"/>
  </div>
</div> -->

      <!-- Right: Form -->
      <div class="col-md-6 form-section">
        <h3 class="text-center">Welcome Back 👋</h3>
        <p class="text-center">Sign in to continue to your dashboard</p>
        
        <form action="/superadmin_login" method="post" id="myForm">
          <div class="mb-4 position-relative">
             <i class="bi bi-person input-icon"></i>
            <input type="text" class="form-control ps-5" id="user_id" name="user_id" placeholder="Username" required>
          </div>
          <div class="mb-4 position-relative">
            <i class="bi bi-lock input-icon"></i>
            <input type="password" class="form-control ps-5" id="password" name="password" placeholder="Password" required>
           <i class="bi bi-eye position-absolute top-50 end-0 translate-middle-y me-3" 
           id="togglePassword" style="cursor: pointer;"></i>
          </div>
          <button type="submit" class="btn btn-primary w-100">Log In</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bootstrap Icons -->
  <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"> -->
  <div id="toast">Please fill correct details</div>
<script>
  const togglePassword = document.getElementById('togglePassword');
  const password = document.getElementById('password');

  togglePassword.addEventListener('click', function () {
    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
    password.setAttribute('type', type);
    
    // Toggle eye icon
    this.classList.toggle('bi-eye');
    this.classList.toggle('bi-eye-slash');
  });
</script>


<script>
  document.getElementById("myForm").addEventListener("submit", async function(event) {
    event.preventDefault();

    const userId = document.getElementById("user_id").value;
    const password = document.getElementById("password").value;

    try {
      const formData = new URLSearchParams();
      formData.append("user_id", userId);
      formData.append("password", password);

      const response = await fetch("/superadmin_login", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: formData,
        redirect: "follow"   // ✅ allow redirects
      });

      // ✅ If backend redirected (login success)
      if (response.redirected && response.url.includes("/superadmin/dashboard")) {
        window.location.href = response.url;
      } else {
        // ❌ Login failed
        showToast("Incorrect user ID or password");
      }

    } catch (error) {
      showToast("Something went wrong. Try again!");
    }
  });

  // ✅ Toast function
  function showToast(message) {
    const toast = document.getElementById("toast");
    toast.innerText = message;
    toast.className = "show";
    setTimeout(() => {
      toast.className = toast.className.replace("show", "");
    }, 3000);
  }
</script>



</body>
</html>

