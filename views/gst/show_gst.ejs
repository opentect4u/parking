<div class="container-fluid">
    <div class="row">
      <div class="card col-12">
        <div class="card-body">
          <div class="titleSec mt-3">
            <button type="button" class="btn btn-primary" id="myBtn"
              style="float: inline-end;border-radius: 6px;width: 7vw;">Add GST</button>
          </div>
          <div class="row mt-5">
            <h4 class="text-dark"><i data-feather="tag" class="feather-icon"></i>&nbsp;<b>Manage GST</b></h2>
          </div>
          <div class="table-responsive mt-3">
            <table id="example" class="table table-striped table-bordered show_data" style="width:100%">
              <thead>
                <tr>
                  <th class="text-dark text-center">Sl. No.</th>
                  <th class="text-dark text-center">GST No.</th>
                  <th class="text-dark text-center">GST Flag</th>
                  <th class="text-dark text-center">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if(data.msg && data.msg.length> 0) { %>
                  <% data.msg.forEach(function(item,index) { %>
                    <tr>
                      <td class="text-center">
                        <%=(index+1)%>
                      </td>
                      <td class="text-center">
                        <%=item.gst_number %>
                      </td>
                      <td class="text-center">
                        <span class="<%=(item.gst_flag=='Y')?'badge badge-success':'badge badge-danger'%>"
                          style="font-size: 16px;">
                          <%=(item.gst_flag=='Y')?"Active":"Deactive"%>
                        </span>
                      </td>
                      <td class="text-center">
                        <a href="/gst/gst_edit?customer_id=<%=item.customer_id%>&&gst_id=<%= item.gst_id%>"
                          class="btn btn-info" style="border-radius: 5px;"><i class="fa fa-edit"></i></a>
                      </td>
                    </tr>
                    <% }); %>
                      <% } else { %>
                        <tr>
                          <td colspan="4" class="text-danger text-center">No data available</td>
                        </tr>
                        <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css"
    rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>
  
  <div class="modal fade" id="myModal">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <h3 class="modal-title text-dark"><i data-feather="user-plus" class="feather-icon"></i>&nbsp;&nbsp;<b>Add
              GST</b>
          </h3>
          <button type="button" class="close" data-dismiss="modal">
            &times;
          </button>
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/gst/save_add_gst" method="post" id="myForm">
            <div class="row">
              <div class="form-group col-3">
                <label for="gst_num" class="text-dark"><b>GST Number:</b></label>
                <input type="text" class="form-control" name="gst_num" id="gst_num" value=""
                  placeholder="Enter GST Number">
              </div>
              <div class="form-group col-3">
                <label for="total_gst" class="text-dark"><b>Total GST:</b></label>
                <select name="total_gst" class="form-control" id="total_gst">
                  <option value="">Select Total GST</option>
                  <option value="0">0%</option>
                  <option value="5">5%</option>
                  <option value="12">12%</option>
                  <option value="18">18%</option>
                  <option value="28">28%</option>
                </select>
              </div>
              <div class="form-group col-3">
                <label for="cgst" class="text-dark"><b>CGST:</b></label>
                <input type="text" class="form-control" name="cgst" id="cgst" value="" placeholder="Enter CGST" readonly>
              </div>
  
              <div class="form-group col-3">
                <label for="sgst" class="text-dark"><b>SGST:</b></label>
                <input type="text" class="form-control" name="sgst" id="sgst" value="" placeholder="Enter SGST" readonly>
              </div>
            </div>
            <div class="row mt-3">
              <div class="form-group col-md-3">
                <input type="submit" value="SUBMIT" class="btn btn-primary"
                  style="margin-left: 38vw;border-radius: 5px;" />
              </div>
            </div>
          </form>
        </div>
  
      </div>
    </div>
  </div>
  

  <script>
    $(document).ready(function () {
      $("#myBtn").click(function () {
        $("#myModal").modal();
      });
    });
  </script>

<script>
  $(document).ready(function () {
    $('#total_gst').change(function () {
      const gstValue = $(this).val();

      if (gstValue) {
        const gst = gstValue / 2;
        $('#cgst').val(gst + '%');
        $('#sgst').val(gst + '%');
      } else {
        $('#cgst').val('');
        $('#sgst').val('');
      }
    });
  });
</script>



