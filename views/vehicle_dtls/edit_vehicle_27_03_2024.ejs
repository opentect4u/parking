<div class="container-fluid">
    <div class="row">
        <div class="card col-12">
            <div class="card-body">
                <div class="titleSec">
                    <h2 class="text-dark"><i class="fa fa-arrow-circle-left" aria-hidden="true" id="back"
                            style="cursor: pointer;">&nbsp;Vehicle Edit Details</i></h2>
                </div>
                <form action="/vehicle/edit_save_vehicle" id="myForm" method="post">
                    <input type="hidden" id="vehicle_id" name="vehicle_id" value="<%= data.vehicle_id %>">

                    <div class="row mt-4">
                        <div class="form-group col-4">
                            <label for="cust_id" class="text-dark"><b>Customer Name:</b></label>
                            <select name="cust_id" class="form-control" id="cust_id" disabled>
                                <option value="">Select Customer Name</option>
                                <option value="<%= data.customer_id %>" <%=user.user_data.customer_id==data.customer_id
                                    ? 'selected' : '' %>><%= data.customer_name %>
                                </option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                              <label for="vehicle_name" class="text-dark"><b>Vehicle Name</b></label>
                              <input type="text" class="form-control" id="vehicle_name" name="vehicle_name" placeholder="Enter Vehicle Name...."
                                value="<%= data.vehicle_name %>">
                            </div>
                          </div>
                         
                          <div class="col-md-4">
                            <div class="form-group">
                              <label for="vehicle_icon" class="text-dark"><b>Vehicle Icon</b></label>
                              <select name="vehicle_icon" class="form-control" id="vehicle_icon">
                                <option value="<%= data.vehicle_icon %>">Select Vehicle Icon</option>
                                <option value="car-hatchback" <%= data.vehicle_icon == 'car-hatchback' ? 'selected' : '' %>>car-hatchback</option>
                                <option value="motorbike" <%= data.vehicle_icon == 'motorbike' ? 'selected' : '' %>>motorbike</option>
                                 </select>
                            </div>
                          </div>
                        <div class="row mt-2">
                            <div class="form-group col-md-6">
                                <input type="submit" value="SUBMIT" class="btn btn-primary btn-block text-center"
                                    style="margin-left: 25vw;border-radius: 5px;" />
                            </div>
                        </div>
                        </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
                    $("#back").click(function () {
                        window.location.href = "/vehicle/vehicle_details";
                    });
    });
</script>