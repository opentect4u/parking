<div class="container-fluid">
    <div class="row">
      <div class="card col-12">
        <div class="card-body">
         
            <div class="titleSec">
                <button type="button" class="btn btn-primary" id="myBtn"
                  style="float: inline-end;border-radius: 6px;width: 6vw;">Add</button>
              </div>
           
      <div class="row mt-4">
            <h4 class="text-dark"><i data-feather="menu" class="feather-icon"></i>&nbsp;<b>Attach Vehicle</b></h4>
          </div>
          <div class="table-responsive mt-3">
            <table id="example" class="table table-striped table-bordered show_data" style="width:100%">
              <thead>
                <tr>
                  <th class="text-dark">Sl. No.</th>
                  <th class="text-dark">vehicle Name</th>
                  <th class="text-dark">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if(data.msg.length > 0){
                    data.msg.forEach(function(item,index) { %>
                      <tr>
                        <td>
                          <%=(index+1)%>
                        </td>
                        <td>
                          <%=item.vehicle_name %>
                        </td>
                        <td>
                          <a href="/vehicle/edit_vehicle_details?customer_id=<%=item.customer_id%>&vehicle_id=<%=item.vehicle_id %>" class="btn btn-info"
                            style="border-radius: 5px;"><i class="fa fa-edit"></i></a>
                        </td>
                      </tr>
                      <% });}else{ %>
                        <tr>
                          <td colspan="3" class="text-danger text-center">No data found</td>
                        </tr>
                        <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="myModal">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <h3 class="modal-title text-dark"><i data-feather="plus-circle" class="feather-icon"></i>&nbsp;<b>Add Vehicle</b>
          </h3>
          <button type="button" class="close" data-dismiss="modal">
            &times;
          </button>
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/vehicle/add_save_vehicle" method="post" id="myForm">
            <div class="row">
              <div class="form-group col-md-6">
                <label for="cust_id" class="text-dark"><b>Customer Name:</b></label>
                <select name="cust_id" class="form-control" id="cust_id">
                  <option value="<%=user.user_data.customer_id %>">
                    <%= user.user_data.customer_name %>
                  </option>
                </select>
              </div>
  
              <div class="col-md-6">
                <div class="form-group">
                  <label for="vehicle_name" class="text-dark"><b>Vehicle Name</b></label>
                  <input type="text" class="form-control" id="vehicle_name" name="vehicle_name" placeholder="Enter Vehicle Name...."
                    value="">
                </div>
              </div>
  
            </div>
            <div class="row mt-3">
              <div class="form-group col-md-3">
                <input type="submit" value="SUBMIT" class="btn btn-primary "
                  style="margin-left: 38vw;border-radius: 6px;" />
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    $(document).ready(function () {
      $("#myBtn").click(function () {
        $("#myModal").modal();
        // $("#myBtn").hide()
      });
    });
  </script>
