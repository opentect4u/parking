<script>
  // Get current path
  const currentPath = window.location.pathname;

  // Get all sidebar links
  const links = document.querySelectorAll('.sidebar-link');

  links.forEach(link => {
    const parentLi = link.closest('.sidebar-item');

    // Match link href with current path
    if (link.getAttribute('href') === currentPath) {
      parentLi.classList.add('active'); // highlight this item

      // If inside a submenu, open the parent
      const collapse = link.closest('.collapse');
      if (collapse) {
        collapse.classList.add('show'); // open submenu
        const parentArrow = collapse.closest('.sidebar-item.has-arrow');
        if (parentArrow) parentArrow.classList.add('open', 'active');
      }
    } else {
      parentLi.classList.remove('active');
    }
  });
</script>
