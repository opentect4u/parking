<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<style>
.left-sidebar {
  position: fixed;
  top: 0; /* start at very top */
  left: 0;
  width: 250px;
  height: 100%;
  /* background: linear-gradient(135deg, #6a11cb, #2575fc); */
  /* background: linear-gradient(135deg, #e7b8d9, #7799d8); */
  background: linear-gradient(135deg, #e7b8d9, #4d648f);
  /* border-radius: 0 10px 20px 0; */
  box-shadow: 4px 0 12px rgba(0,0,0,0.2);
}

.sidebar-nav #sidebarnav .sidebar-item.selected>.sidebar-link {
    border-radius: 0 60px 60px 0;
    color: #f3ebeb !important;
    background: linear-gradient(to right, #504c60, #483bb7, #7574ea, #6a75e9, #5f76e8);
    box-shadow: 0 7px 12px 0 rgba(95, 118, 232, .21);
    opacity: 1;
}
.scroll-sidebar {
  height: 100%;
  overflow-y: auto;
  padding-top: 1rem;
}

.sidebar-nav ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sidebar-item {
  margin: 5px 10px;
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 18px;
  font-size: 15px;
  font-weight: 500;
  color: #f1e9e9;
  border-radius: 12px;
  transition: all 0.3s ease;
}

.sidebar-link i {
  width: 20px;
}

.sidebar-link:hover,
.sidebar-item.active > .sidebar-link {
  background: rgba(255, 255, 255, 0.15);
  color: #ffd166;
  transform: translateX(5px);
}

.sidebar-item.has-arrow > a::after {
  content: "›";
  font-size: 14px;
  margin-left: auto;
  transition: transform 0.3s ease;
}

.sidebar-item.has-arrow.open > a::after {
  transform: rotate(90deg);
}

.collapse {
  display: none;
  margin-left: 20px;
}

.sidebar-item.has-arrow.open > .collapse {
  display: block;
}

/* Scrollbar styling */
.scroll-sidebar::-webkit-scrollbar {
  width: 6px;
}
.scroll-sidebar::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.4);
  border-radius: 10px;
}

.sidebar-nav {
    padding-top: 0px;
}
/* .sidebar-item.has-arrow > a:after {
  content: "\f107"; 
} */
</style>


