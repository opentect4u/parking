  gap: 8px;
}

.user-menu .dropdown-item i {
  width: 18px;
} */

.gradient-text {
  font-size: 20px;
  font-weight: 700;
  margin: 0 0 12px;
  background: linear-gradient(90deg, #ff512f, #dd2476, #2575fc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 0px;
}
.modal {
  z-index: 1050 !important;
}
.modal-backdrop {
  z-index: 1040 !important;
}

</style>

