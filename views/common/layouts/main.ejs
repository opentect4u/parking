<style>
/* Modal Glass Effect */
.modal-content {
  border-radius: 20px;
  border: none;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  animation: fadeInUp 0.3s ease;
}

/* Modal Header */
.modal-header {
  border-bottom: none;
  text-align: center;
  justify-content: center;
  background: linear-gradient(135deg, #e7b8d9, #7799d8);
  border-top-left-radius: 20px;
  border-top-right-radius: 20px;
}

.modal-title {
  font-size: 22px;
  font-weight: 700;
  color: #fff;
}

.modal-header .close {
  position: absolute;
  right: 20px;
  top: 20px;
  color: #fff;
  opacity: 0.8;
  font-size: 28px;
  transition: 0.3s;
}
.modal-header .close:hover { opacity: 1; }

/* Modal Body */
.modal-body {
  padding: 2rem;
  background: #ddd;
  border-radius: 0 0 20px 20px;
}

/* Labels */
.modal-body label {
  font-weight: 600;
  color: #444;
}

/* Inputs with eye */
.password-wrapper {
  position: relative;
}
.password-wrapper .form-control {
  border-radius: 10px;
  padding: 0.6rem 2.5rem 0.6rem 1rem; /* space for eye */
  border: 1px solid #ccc;
  transition: 0.3s ease;
}
.password-wrapper .form-control:focus {
  border-color: #7799d8;
  box-shadow: 0 0 8px rgba(119, 153, 216, 0.5);
}
.password-wrapper .toggle-eye {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  cursor: pointer;
  color: #666;
  font-size: 18px;
}
.password-wrapper .toggle-eye:hover {
  color: #000;
}

/* Submit Button */
.modal-body .btn-primary {
  background: linear-gradient(135deg, #e7b8d9, #7799d8);
  border: none;
  padding: 0.7rem 2rem;
  font-weight: 600;
  border-radius: 50px;
  transition: 0.3s ease;
  display: block;
  margin: 2rem auto 0;
}
.modal-body .btn-primary:hover {
  background: linear-gradient(135deg, #7799d8, #e7b8d9);
  transform: scale(1.05);
}

/* Animation */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>

<!-- Modal -->
<div class="modal fade" id="changepwd" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      
      <!-- Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i class="fa fa-key"></i> Change Password</h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Body -->
      <div class="modal-body">
        <form action="/superadmin_password" method="post" id="myForm">
          <div class="row g-3">
            <div class="col-md-4">
              <label for="old_pwd">Old Password</label>
              <div class="password-wrapper">
                <input type="password" name="old_pwd" id="old_pwd" class="form-control" placeholder="Enter old password" required>
                <i class="fa fa-eye toggle-eye" onclick="togglePassword('old_pwd', this)"></i>
              </div>
            </div>
            <div class="col-md-4">
              <label for="new_pwd">New Password</label>
              <div class="password-wrapper">
                <input type="password" name="new_pwd" id="new_pwd" class="form-control" placeholder="Enter new password" required>
                <i class="fa fa-eye toggle-eye" onclick="togglePassword('new_pwd', this)"></i>
              </div>
            </div>
            <div class="col-md-4">
              <label for="con_pwd">Confirm Password</label>
              <div class="password-wrapper">
                <input type="password" name="con_pwd" id="con_pwd" class="form-control" placeholder="Confirm password" required>
                <i class="fa fa-eye toggle-eye" onclick="togglePassword('con_pwd', this)"></i>
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-primary">Submit</button>
        </form>
      </div>

    </div>
  </div>
</div>

<script>
function togglePassword(fieldId, icon) {
  const field = document.getElementById(fieldId);
  if (field.type === "password") {
    field.type = "text";
    icon.classList.remove("fa-eye");
    icon.classList.add("fa-eye-slash");
  } else {
    field.type = "password";
    icon.classList.remove("fa-eye-slash");
    icon.classList.add("fa-eye");
  }
}
</script>



