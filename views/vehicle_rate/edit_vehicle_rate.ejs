<div class="container-fluid">
    <div class="row">
        <div class="card col-12">
            <div class="card-body">
                <div class="titleSec">
                    <h2 class="text-dark"><i class="fa fa-arrow-circle-left" aria-hidden="true" id="back"
                            style="cursor: pointer;">&nbsp;Vehicle Rate Edit Details</i></h2>
                </div>
                <form action="/rate/edit_save_vehicle_rate" id="myForm" method="post">
                    <input type="hidden" id="sl_no" name="sl_no" value="<%= data.sl_no %>">

                    <div class="row mt-4">
                        <div class="form-group col-4">
                            <label for="cust_id" class="text-dark"><b>Customer Name:</b></label>
                            <select name="cust_id" class="form-control" id="cust_id" disabled>
                                <option value="">Select Customer Name</option>
                                <option value="<%= data.customer_id %>" <%=user.user_data.customer_id==data.customer_id
                                    ? 'selected' : '' %>><%= data.customer_name %>
                                </option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                              <label for="rate_type"><b style="color: black;">Rate Type:</b></label>
                              <select name="rate_type" class="form-control" id="rate_type">
                                <option value="">Select Rate Type</option>
                                <option value="H" <%= data.rate_type == 'H' ? 'selected' : '' %>>Hourly</option>
                                <option value="F" <%= data.rate_type == 'F' ? 'selected' : '' %>>Fixed</option>
                              </select>
                            </div>
                          </div>
                         
                          <div class="col-md-4">
                            <div class="form-group">
                              <label for="vehicle_id" class="text-dark"><b>Vehicle ID</b></label>
                             <input type="text" class="form-control" id="vehicle_id" name="vehicle_id" value="<%= data.vehicle_id %>">
                            </div>
                          </div>

                          <div class="col-md-4">
                            <div class="form-group">
                              <label for="frm_hr" class="text-dark"><b>From Hour</b></label>
                             <input type="number" max="24" min="0" class="form-control" id="frm_hr" name="frm_hr" value="<%= data.from_hour %>">
                            </div>
                          </div>
              
                          <div class="col-md-4">
                            <div class="form-group">
                              <label for="to_hr" class="text-dark"><b>To Hour</b></label>
                             <input type="number" max="24" min="0" class="form-control" id="to_hr" name="to_hr" value="<%= data.to_hour %>">
                            </div>
                          </div>
              
                          <div class="col-md-4">
                            <div class="form-group">
                              <label for="park_fee" class="text-dark"><b>Parking Fee</b></label>
                             <input type="text" class="form-control" id="park_fee" name="park_fee" value="<%= data.vehicle_rate %>">
                            </div>
                          </div>

                        <div class="row mt-2">
                            <div class="form-group col-md-6">
                                <input type="submit" value="SUBMIT" class="btn btn-primary btn-block text-center"
                                    style="margin-left: 25vw;border-radius: 5px;" />
                            </div>
                        </div>
                        </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
                    $("#back").click(function () {
                        window.location.href = "/rate/vehicle_rate_dtls";
                    });
    });
</script>