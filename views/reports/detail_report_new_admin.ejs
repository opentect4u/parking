<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="card shadow-lg rounded-4 border-0 p-4" style="background: linear-gradient(to right, #c5cedf, #bb9f9f00);">
                <h3 class="card-title mb-4 text-primary" style="margin-left: 30vw;">
                    <%= title %>
                </h3>

                   <div class="row g-3 align-items-end">
  <!-- From Date -->
  <div class="col-md-3">
    <label for="frm_dt" class="form-label fw-bold text-dark"><b>From Date</b></label>
    <input type="datetime-local" id="frm_dt" name="frm_dt" class="form-control form-control-lg rounded-pill shadow-sm input-custom" required>
  </div>

  <!-- To Date -->
  <div class="col-md-3">
    <label for="to_dt" class="form-label fw-bold text-dark"><b>To Date</b></label>
    <input type="datetime-local" id="to_dt" name="to_dt" class="form-control form-control-lg rounded-pill shadow-sm input-custom" required>
  </div>

  <!-- Pay Mode -->
  <div class="col-md-3">
    <label for="pay_mode" class="form-label fw-bold text-dark"><b>Pay Mode</b></label>
    <select name="pay_mode" class="form-select rounded-pill shadow-sm select-custom" id="pay_mode">
      <option value="">Select Pay Mode</option>
      <option value="C">CASH</option>
      <option value="U">UPI</option>
      <option value="A" selected>All</option>
    </select>
  </div>

   <!-- Operator Select -->
  <div class="col-md-3">
    <label for="operator_id" class="form-label fw-bold text-dark"><b>Operator Name</b></label>
    <select name="operator_id" class="form-select rounded-pill shadow-sm select-custom" id="operator_id">
      <option value="">Select Operator Name</option>
      <option value="A" selected>All Operators</option>
      <% if (operators.msg && operators.msg.length > 0) { %>
  <% operators.msg.forEach(operator => { %>
    <option value="<%= operator.operator_id %>"><%= operator.operator_name %></option>
  <% }) %>
<% } %>
    </select>
  </div>
</div>
<div class="row mt-3">
  <!-- Search button beside -->
<div class="col-md-12 d-flex justify-content-center">
    <button type="button" class="btn btn-gradient shadow-sm px-4" id="btnSubmit">
      <i class="fa fa-search me-2"></i> Search
    </button>
  </div>
</div>



                <!-- <div class="card-body" id="resultDiv"> -->
                    <div class="dateWiseDataTable mt-5" id="resultDiv" style="display: none;">
                    <h5 class="text-center text-secondary mb-3">
                       <span id="searchCred"></span>
                    </h5>
                    <div class="table-responsive shadow-sm rounded-3" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-bordered table-hover align-middle" style="min-width: 1200px;">
                            <thead class="table-fixed-header">
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Receipt No.</th>
                                    <th scope="col">Date Time In</th>
                                    <th scope="col">Machine Sl. No. In</th>
                                    <th scope="col">Vehicle Type</th>
                                    <th scope="col">Vehicle No.</th>
                                    <th scope="col">Date Time Out</th>
                                    <th scope="col">Machine Sl. No. Out</th>
                                    <th scope="col">Base Amount</th>
                                    <th scope="col">Advance Amount</th>
                                    <th scope="col">CGST</th>
                                    <th scope="col">SGST</th>
                                    <!-- <th scope="col">Paid Amount</th> -->
                                    <th scope="col">MIS Charges</th>
                                    <th scope="col">Net Amount</th>
                                    <th scope="col">Mode</th>
                                    <th scope="col">Operator Name</th>
                                </tr>
                            </thead>
                            <tbody> </tbody>
                            
                            <tfoot>
    <tr>
        <td colspan="8">Total</td>
        <td scope="col" id="base_amt"><b>0</b></td>
        <td scope="col" id="advance_amt"><b>0</b></td>
        <td scope="col" id="cgst"><b>0</b></td>
        <td scope="col" id="sgst"><b>0</b></td>
        <td scope="col" id="other_chrges"><b>0</b></td>
        <td scope="col" id="tot_amt"><b>0</b></td>
        <td></td>
        <td></td>
    </tr>
    <tr style="display: none;">
        <td scope="col" colspan="2">Total UPI</td>
        <td scope="col" class="text-left" id="tot_upi" colspan="14"></td>
    </tr>
    <tr style="display: none;">
        <td scope="col" colspan="2">Total Cash</td>
        <td scope="col" class="text-left" id="tot_cash" colspan="14"></td>
    </tr> 
</tfoot>

                        </table>


              <div class="text-end mt-3">
  <button class="btn btn-gradient-print btn-sm px-4 shadow-sm me-2 no-print" onclick="printDiv()">
    <i class="fa fa-print me-2"></i> Print
  </button>
  <button class="btn btn-success btn-sm px-4 shadow-sm no-print" onclick="downloadExcel()">
    <i class="fa fa-file-excel me-2"></i> Excel
  </button>
</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @media print {
    .no-print {
        display: none !important;
    }
}

@media print {
    .no-prints {
        display: none !important;
    }
}

    .table-fixed-header th {
   background-color: #1c2d41; /* Your fixed color */
  color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 5;
}


/* Optional: keep footer visible too */
.table tfoot tr {
  background-color: #c0b9b9;
  font-weight: 700;
}
    .btn-gradient-print {
  background: linear-gradient(90deg, #ff7e5f, #feb47b); /* Warm gradient */
  color: rgb(20, 14, 14);
  border: none;
  border-radius: 50px;
  font-weight: 500;
  transition: all 0.3s;
}
.btn-gradient-print:hover {
  /* background: linear-gradient(90deg, #feb47b, #ff7e5f); */
  /* transform: scale(1.05); */
  /* box-shadow: 0 4px 15px rgba(255, 126, 95, 0.4); */
}
.input-custom, .select-custom {
  transition: all 0.3s;
  border: 1px solid #ced4da;
  padding: 12px 20px;
  font-size: 1rem;
}
.input-custom:focus, .select-custom:focus {
  box-shadow: 0 0 10px rgba(13, 110, 253, 0.3);
  border-color: #0d6efd;
}
.btn-gradient {
  background: linear-gradient(90deg, #6a11cb, #2575fc);
  color: white;
  border: none;
  border-radius: 50px;
  transition: all 0.3s;
}
.btn-gradient:hover {
  background: linear-gradient(90deg, #2575fc, #6a11cb);
  transform: scale(1.05);
}
.table-hover tbody tr:hover {
  background-color: rgba(13, 110, 253, 0.1);
}
#btnSubmit {
  height: calc(2.25rem + 2px); /* default .form-select height */
  font-size: 0.95rem;
}
.btn-success {
  background: linear-gradient(90deg, #28a745, #218838);
  color: white;
  border-radius: 50px;
  border: none;
}

.select-custom {
  width: 100%;
  padding: 12px 20px; /* ok, may reduce horizontal padding */
}

</style>

<script>
function downloadExcel() {
    // Get the table element
    var table = document.querySelector("#resultDiv table");

    if (!table) {
        alert("No data available to export!");
        return;
    }

    // Convert table to worksheet
    var workbook = XLSX.utils.book_new();
    var worksheet = XLSX.utils.table_to_sheet(table);

    XLSX.utils.book_append_sheet(workbook, worksheet, "Detail Report");

    // Download Excel file
    XLSX.writeFile(workbook, "Detail_Report.xlsx");
}
</script>


    <script src="https://raw.githubusercontent.com/phstc/jquery-dateFormat/master/dist/dateFormat.min.js"></script>
    <script>
        $(document).ready(function(){
            $('#resultDiv').hide()
        })
    </script>

    <script>
        var cust = <%= user.userData.customer_id %>;
        var custName = "<%= user.userData.customer_name %>";

        $('#btnSubmit').on('click', function(){
    var frm_dt = $('#frm_dt').val();
    var to_dt = $('#to_dt').val();
    var custId = cust
    var pay_mode = $('#pay_mode').val();
    var operator_id = $('#operator_id').val();
    // var custName = $("#custId option:selected").text(); // Get selected location name
    console.log(custName);
    

    if(frm_dt && to_dt && custId && pay_mode, operator_id){
                $('#resultDiv').show();
                $('#resultDiv table tbody').empty();

                $('#searchCred').html(`<b>Detail Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);

        $.ajax({
            method: "POST",
            url: "/report/get_details_report_new",
            data: { frm_dt, to_dt, custId, pay_mode, operator_id },
            dataType: "json",  // IMPORTANT: tells jQuery to parse JSON automatically
            beforeSend: function () {
                $(".preloader").fadeIn();
            },
            success: function(res){
                console.log(res); // DEBUG: check data in console

                  let base_amt_tot = 0, advance_amt_tot = 0, cgst_tot = 0, sgst_tot = 0, paid_amt_tot = 0, other_chrges_tot = 0, tot_amt_tot = 0;
                    let tot_upi = 0, tot_cash = 0;


                if(res.suc > 0 && res.msg.length > 0){

                    let i = 1;

                    res.msg.forEach(dt => {
                        const base = parseFloat(dt.base_amt);
                        const advance = parseFloat(dt.advance_amt);
                        const cgst = parseFloat(dt.cgst);
                        const sgst = parseFloat(dt.sgst);
                        const other_charges = parseFloat(dt.other_charges);
                        const total_amt = base + advance + cgst + sgst + other_charges; // Adjust logic as needed

                        base_amt_tot += base;
                        advance_amt_tot += advance;
                        cgst_tot += cgst;
                        sgst_tot += sgst;
                        // paid_amt_tot += paid;
                        other_chrges_tot += other_charges;
                        tot_amt_tot += total_amt;

                        if(dt.pay_mode == 'C') tot_cash += total_amt;
                        if(dt.pay_mode == 'U') tot_upi += total_amt;

                        let dateTimeOut = dt.date_time_out && dt.date_time_out !== dt.date_time_in ? createDateTime(dt.date_time_out) : '';
                        
                         // ✅ check if date_time_in == date_time_out

                        $('#resultDiv table tbody').append(`
                            <tr>
                                <td class=text-dark>${i}</td>
                                <td class="text-dark">${dt.receipt_no == null ? '' : String(dt.receipt_no).slice(-5)}</td>
                                <td class=text-dark>${createDateTime(dt.date_time_in)}</td>
                                <td class=text-dark>${dt.device_id}</td>
                                <td class=text-dark>${dt.vehicle_name}</td>
                                <td class=text-dark>${dt.vehicle_no}</td>
                                 <td class=text-dark>${dateTimeOut}</td>
                                <td class=text-dark>${dt.device_id_out}</td>
                                <td class=text-dark>${base.toFixed(2)}</td>
                                <td class=text-dark>${advance.toFixed(2)}</td>
                                <td class=text-dark>${cgst.toFixed(2)}</td>
                                <td class=text-dark>${sgst.toFixed(2)}</td>
                                <td class=text-dark>${other_charges.toFixed(2)}</td>
                                <td class=text-dark>${total_amt.toFixed(2)}</td>
                                <td class=text-dark>${dt.pay_mode == 'U' ? 'UPI' : dt.pay_mode == 'C' ? 'CASH' : ''}</td>
                                <td class=text-dark>${dt.operator_name}</td>
                            </tr>
                        `);
                        i++;
                    });

                } else {
                    $('#resultDiv table tbody').html('<tr><td colspan="16" class="text-center text-danger">No Data Found</td></tr>');
                }

                // Update footer totals

                    $('#base_amt').text(base_amt_tot.toFixed(2));
                    $('#advance_amt').text(advance_amt_tot.toFixed(2));
                    $('#cgst').text(cgst_tot.toFixed(2));
                    $('#sgst').text(sgst_tot.toFixed(2));
                    $('#other_chrges').text(other_chrges_tot.toFixed(2));
                    $('#tot_amt').text(tot_amt_tot.toFixed(2)).show();



    if(pay_mode == 'A'){
        $('#tot_upi').parent().show();
        $('#tot_cash').parent().show();
        $('#tot_upi').text(tot_upi.toFixed(2));
        $('#tot_cash').text(tot_cash.toFixed(2));
    } else if(pay_mode == 'U'){
        $('#tot_upi').parent().show();
        $('#tot_cash').parent().hide();
        $('#tot_upi').text(tot_upi.toFixed(2));
        $('#tot_cash').text('');
    } else if(pay_mode == 'C'){
        $('#tot_upi').parent().hide();
        $('#tot_cash').parent().show();
        $('#tot_upi').text('');
        $('#tot_cash').text(tot_cash.toFixed(2));
    }
            },
            complete: function () {
                $(".preloader").fadeOut();
            }
        });
    }
});

    </script>

<script>
function printDiv() {
    var divToPrint = document.getElementById('resultDiv');

    // Temporarily remove scroll styling
    var tableWrapper = divToPrint.querySelector('.table-responsive');
    var originalStyle = tableWrapper.getAttribute('style');
    tableWrapper.style.maxHeight = 'none';
    tableWrapper.style.overflowY = 'visible';

    var WindowObject = window.open('', 'Print-Window');
    WindowObject.document.open();
    WindowObject.document.writeln('<!DOCTYPE html>');
    WindowObject.document.writeln('<html><head><title>Print</title><style type="text/css">');

    WindowObject.document.writeln(`
        @media print {
            table { border-collapse: collapse; font-size: 10px; width: 100%; }
            th, td { border: 1px solid black; padding: 6px; font-family: Arial, Helvetica, sans-serif; text-align: left; }
            .table .thead-dark th { color: #fff; background-color: #1c2d41; }
            tfoot { font-weight: 700; color: #000; }

             /* Hide elements with no-print or no-prints class */
            .no-print, .no-prints { display: none !important; }
        }
    `);

    WindowObject.document.writeln('</style></head><body onload="window.print()">');
    WindowObject.document.writeln(divToPrint.innerHTML);
    WindowObject.document.writeln('</body></html>');
    WindowObject.document.close();

     setTimeout(function () {
            WindowObject.close();
        }, 10);

    // Restore original styling
    tableWrapper.setAttribute('style', originalStyle);
}


</script>