    <script src="https://raw.githubusercontent.com/phstc/jquery-dateFormat/master/dist/dateFormat.min.js"></script>
    <script>
        $(document).ready(function(){
            $('#resultDiv').hide()
        })
    </script>

    <script>
      $('#btnSubmit').on('click', function () {
      var frm_dt = $('#frm_dt').val();
      var to_dt = $('#to_dt').val();
      var custId = $('#custId').val();
      var custName = $("#custId option:selected").text(); // Get selected location name

      if (frm_dt != '' && to_dt != '' && custId != '') {
        $('#resultDiv').show();
        // $('#resultDiv table tbody').empty();
        var tbody = $('#resultDiv table tbody'); // <-- FIX: define tbody
        tbody.empty();

        // Always show location name and dates
        $('#searchCred').html(`<b>Shift Wise Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);


        $.ajax({
            method: "POST",
            url: "/report/get_shift_wise_repo_new",
            data: { frm_dt, to_dt, custId },
            dataType: "json", // <-- automatically parses JSON
            beforeSend: function () {
                $(".preloader").fadeIn();
            },
            success: function (res) {
                 if(!res || !res.msg){
                    console.error("Invalid response:", res);
                    return;
                }
                var paid_amt_tot = 0;
                var base_amt_tot = 0;
                var advance_amt_tot = 0;
                var cgst_amt_tot = 0;
                var sgst_amt_tot = 0;
                var total_amt_tot = 0;
                var tot_other_charges = 0;
                var tot_amt_tot = 0;

                // $('#resultDiv').show();
                // $('#resultDiv table tbody').empty();

                if (res.suc > 0 && res.msg.length > 0) {
                        // $('#searchCred').html(`<b>Operator Wise Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);
                        let i = 1;
                        for (let dt of res.msg) {
                            let base_amt = parseFloat(dt.base_amt) || 0;
                            let advance_amt = parseFloat(dt.advance_amt) || 0;
                            let cgst = parseFloat(dt.cgst) || 0;
                            let sgst = parseFloat(dt.sgst) || 0;
                            // let paid_amt = parseFloat(dt.paid_amt);
                            let other_charge_amt = parseFloat(dt.other_charges) || 0;
                            // let total_amt = paid_amt + advance_amt;
                            let total_amt = base_amt + advance_amt + cgst + sgst + other_charge_amt;

                            base_amt_tot += base_amt;
                            advance_amt_tot += advance_amt;
                            cgst_amt_tot += cgst;
                            sgst_amt_tot += sgst;
                            // paid_amt_tot += paid_amt;
                            tot_other_charges += other_charge_amt;
                            tot_amt_tot += total_amt;

                            // $('#resultDiv table tbody').append(`
                            tbody.append(`
                                <tr>
                                    <td class=text-dark>${i}</td>
                                    <td class=text-dark>${dt.mc_srl_no_out}</td>
                                    <td class=text-dark>${dt.vehicleType}</td>
                                    <td class=text-dark>${dt.tot_vehi}</td>
                                    <td class=text-dark>${dt.opratorName}</td>
                                    <td class=text-dark>${dt.shift_name}</td>
                                    <td class=text-dark>${base_amt.toFixed(2)}</td>
                                    <td class=text-dark>${advance_amt.toFixed(2)}</td>
                                    <td class=text-dark>${cgst.toFixed(2)}</td>
                                    <td class=text-dark>${sgst.toFixed(2)}</td>
                                    <!-- <td class=text-dark>${other_charge_amt.toFixed(2)}</td> -->
                                    <td class=text-dark>${total_amt.toFixed(2)}</td>
                                </tr>
                            `);
                            i++;
                        }
                    }else {
                    tbody.append('<tr><td colspan="11" class="text-center text-danger">No Data Found</td></tr>');
                    }
                        $('#tot_base').text(base_amt_tot.toFixed(2));
                        $('#advance_amt').text(advance_amt_tot.toFixed(2));
                        $('#tot_cgst').text(cgst_amt_tot.toFixed(2));
                        $('#tot_sgst').text(sgst_amt_tot.toFixed(2));
                        // $('#paid_amt').text(paid_amt_tot.toFixed(2));
                        // $('#tot_other_charges').text(tot_other_charges.toFixed(2));
                        $('#tot_amt').text(tot_amt_tot.toFixed(2));
            },
             error: function(xhr, status, err){
                console.error("AJAX Error:", status, err);
            },
            complete: function () {
                $(".preloader").fadeOut();
            }
        });
    }
});

</script>

<script>
// Show button on scroll
window.onscroll = function () {
    const topBtn = document.getElementById("goTopBtn");
    const downBtn = document.getElementById("goDownBtn");

    if (document.body.scrollTop > 100 || document.documentElement.scrollTop > 100) {
        topBtn.style.display = "block";
    } else {
        topBtn.style.display = "none";
    }

    // Show bottom button only if NOT already at bottom
    if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 100) {
        downBtn.style.display = "none";
    } else {
        downBtn.style.display = "block";
    }
};

// Scroll to top
document.getElementById("goTopBtn").onclick = function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
};

// Scroll to bottom
document.getElementById("goDownBtn").onclick = function () {
    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
};
</script>

