<style>
    .table-fixed-header th {
  background-color: #1c2d41; /* Your fixed color */
  color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 5;
}

/* Optional: keep footer visible too */
.table tfoot tr {
  background-color: #c0b9b9;
  font-weight: 700;
}
    .btn-gradient-print {
  background: linear-gradient(90deg, #ff7e5f, #feb47b); /* Warm gradient */
  color: rgb(20, 14, 14);
  border: none;
  border-radius: 3px;
  font-weight: 500;
  transition: all 0.3s;
}
.btn-gradient-print:hover {
  /* background: linear-gradient(90deg, #feb47b, #ff7e5f); */
  /* transform: scale(1.05); */
  /* box-shadow: 0 4px 15px rgba(255, 126, 95, 0.4); */
}
.input-custom, .select-custom {
  transition: all 0.3s;
  border: 1px solid #ced4da;
  padding: 12px 20px;
  font-size: 1rem;
}
.input-custom:focus, .select-custom:focus {
  box-shadow: 0 0 10px rgba(13, 110, 253, 0.3);
  border-color: #0d6efd;
}
.btn-gradient {
  background: linear-gradient(90deg, #6a11cb, #2575fc);
  color: white;
  border: none;
  border-radius: 50px;
  transition: all 0.3s;
  margin-left: 30vw;
}
.btn-gradient:hover {
  background: linear-gradient(90deg, #2575fc, #6a11cb);
  transform: scale(1.05);
}
.table-hover tbody tr:hover {
  background-color: rgba(13, 110, 253, 0.1);
}
    .btn-success {
  background: linear-gradient(90deg, #28a745, #24422b);
  color: white;
  border-radius: 3px;
  border: none;
}
#goTopBtn, #goDownBtn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 999;
    background-color: #8a4286;
    color: white;
    border: none;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
    display: none;
    box-shadow: 0px 3px 6px rgba(0,0,0,0.3);
}

#goTopBtn {
    bottom: 90px;
}

/* Bottom button appears above top button */
#goDownBtn {
    bottom: 30px;
}

#goTopBtn:hover, #goDownBtn:hover {
    background-color: #8a4286;
}
.simple-footer {
  text-align: center;
  font-size: 14px;
  /* color: #6b7280;   soft gray */
  color: black;
  padding: 12px 0;
  margin-left: 59vw;
}
