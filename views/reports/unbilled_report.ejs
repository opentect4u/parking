<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-12">
      <div class="card shadow-lg rounded-4 border-0 p-4" style="background: linear-gradient(to right, #c5cedf, #bb9f9f00)">
        <h3 class="card-title mb-4 text-center text-primary"><%= title %></h3>
        
        <!-- Search Form -->
        <div class="row g-3 align-items-end">
          <!-- From Date -->
          <div class="col-md-4">
            <label for="frm_dt" class="form-label fw-bold text-dark"><b>From Date</b></label>
            <input type="datetime-local" id="frm_dt" name="frm_dt" class="form-control form-control-lg rounded-pill shadow-sm input-custom" required>
          </div>

          <!-- To Date -->
          <div class="col-md-4">
            <label for="to_dt" class="form-label fw-bold text-dark"><b>To Date</b></label>
            <input type="datetime-local" id="to_dt" name="to_dt" class="form-control form-control-lg rounded-pill shadow-sm input-custom" required>
          </div>

          <!-- Customer Select -->
          <div class="col-md-4">
            <label for="custId" class="form-label fw-bold text-dark"><b>Location Name</b></label>
            <select name="custId" class="form-select form-select-lg rounded-pill shadow-sm select-custom" id="custId">
              <option value="">Select Location Name</option>
              <% if (data.msg && data.msg.length > 0) { %>
                <% data.msg.forEach(customer => { %>
                  <option value="<%= customer.customer_id %>"><%= customer.customer_name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
        </div>

        <!-- Small Search Button -->
        <div class="row mt-3">
          <div class="col text-center">
            <button type="button" class="btn btn-gradient btn-sm px-4 shadow-sm" id="btnSubmit">
              <i class="fa fa-search me-1"></i> Search
            </button>
          </div>
        </div>

        <!-- Results Section -->
        <div class="dateWiseDataTable mt-4" id="resultDiv" style="display: none;">
  <h5 class="text-center text-secondary mb-3"><span id="searchCred"></span></h5>
  <div class="table-responsive shadow-sm rounded-3" style="max-height: 400px; overflow-y: auto;">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-fixed-header">
        <tr>
          <th>#</th>
          <th>Receipt No.</th>
          <th>Date Time In</th>
          <th>Machine Sl. No. In</th>
          <th>Vehicle Type</th>
          <th>Vehicle No.</th>
          <!-- <th>Advance Amount</th> -->
          <th>Operator Name</th>
        </tr>
      </thead>
      <tbody></tbody>
      <!-- <tfoot>
        <tr>
          <td colspan="6" class="fw-bold text-end">Total</td>
          <td id="tot_amt" class="fw-bold">0</td>
          <td></td>
        </tr>
      </tfoot> -->
    </table>

    <!-- Gorgeous Print Button -->
    <!-- <div class="text-end mt-3">
      <button class="btn btn-gradient-print btn-sm px-5 shadow-sm" onclick="printDiv()">
        <i class="fa fa-print me-2"></i> Print
      </button>
    </div> -->

      <div class="text-end mt-3">
  <button class="btn btn-gradient-print btn-sm px-4 shadow-sm me-2 no-print" onclick="printDiv()">
    <i class="fa fa-print me-2"></i> Print
  </button>
  <button class="btn btn-success btn-sm px-4 shadow-sm no-print" onclick="downloadExcel()">
    <i class="fa fa-file-excel me-2"></i> Excel
  </button>
</div>
  </div>
</div>

      </div>
    </div>
  </div>
</div>

<style>
   @media print {
    .no-print {
        display: none !important;
    }
}
    .table-fixed-header th {
  background-color: #1c2d41; /* Your fixed color */
  color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 5;
}

/* Optional: keep footer visible too */
.table tfoot tr {
  background-color: #c0b9b9;
  font-weight: 700;
}
    .btn-gradient-print {
  background: linear-gradient(90deg, #ff7e5f, #feb47b); /* Warm gradient */
  color: rgb(20, 14, 14);
  border: none;
  border-radius: 50px;
  font-weight: 500;
  /* transition: all 0.3s; */
}
/* .btn-gradient-print:hover {
  background: linear-gradient(90deg, #feb47b, #ff7e5f);
  transform: scale(1.05); 
  box-shadow: 0 4px 15px rgba(255, 126, 95, 0.4);
}  */
.input-custom, .select-custom {
  transition: all 0.3s;
  border: 1px solid #ced4da;
  padding: 12px 20px;
  font-size: 1rem;
}
.input-custom:focus, .select-custom:focus {
  box-shadow: 0 0 10px rgba(13, 110, 253, 0.3);
  border-color: #0d6efd;
}
.btn-gradient {
  background: linear-gradient(90deg, #6a11cb, #2575fc);
  color: white;
  border: none;
  border-radius: 50px;
  /* transition: all 0.3s; */
}
/* .btn-gradient:hover {
  background: linear-gradient(90deg, #2575fc, #6a11cb);
  transform: scale(1.05);
} */
.table-hover tbody tr:hover {
  background-color: rgba(13, 110, 253, 0.1);
}
.btn-success {
  background: linear-gradient(90deg, #28a745, #218838);
  color: white;
  border-radius: 50px;
  border: none;
}
</style>

<script>
$(document).ready(function() {
    $('#btnSubmit').on('click', function() {
        var frm_dt = $('#frm_dt').val();
        var to_dt = $('#to_dt').val();
        var custId = $('#custId').val();
       var custName = $("#custId option:selected").text(); // Get selected location name
        // console.log(frm_dt,to_dt,custId);
        

        if(frm_dt !== '' && to_dt !== '' && custId !== '') {
           $('#resultDiv').show();
           $('#resultDiv table tbody').empty();

            $('#searchCred').html(`<b>Unbilled Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);



            $.ajax({
                method: "POST",
                url: "/report/get_unbilled_report",
                data: { frm_dt, to_dt, custId },
                dataType: "html",
                beforeSend: function () { $(".preloader").fadeIn(); },
                success: function (result) {
                    var res = JSON.parse(result);
                    var adv_amt_tot = 0;
                    // $('#resultDiv').show();
                    // $('#resultDiv table tbody').empty();

                    if(res.suc > 0 && res.msg.length > 0) {
                        // $('#searchCred').html(`<b>Unbilled Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);
                        //  $('#searchCred').html(`<b>Unbilled Report${custId ? ' of ' + custName : ''} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);
                        let i = 1;
                        for(let dt of res.msg){
                            adv_amt_tot += dt.advance_amt;
                            $('#resultDiv table tbody').append(`
                                <tr>
                                    <td class=text-dark>${i}</td>
                                    <td class=text-dark>${dt.receipt_no}</td>
                                    <td class=text-dark>${createDateTime(dt.date_time_in)}</td>
                                    <td class=text-dark>${dt.device_id}</td>
                                    <td class=text-dark>${dt.vehicle_name}</td>
                                    <td class=text-dark>${dt.vehicle_no}</td>
                                    <td class=text-dark>${dt.operator_name}</td>
                                </tr>
                            `);
                            i++;
                        }
                        $('#tot_amt').text(adv_amt_tot);
                    } else {
                        $('#resultDiv table tbody').append('<tr><td colspan="7" class="text-center text-danger">No Data Found</td></tr>');
                        $('#tot_amt').text(adv_amt_tot);
                    }
                },
                complete: function () { $(".preloader").fadeOut(); }
            });
        }
    });
});
</script>

<script>
function downloadExcel() {
    // Get the table element
    var table = document.querySelector("#resultDiv table");

    if (!table) {
        alert("No data available to export!");
        return;
    }

    // Convert table to worksheet
    var workbook = XLSX.utils.book_new();
    var worksheet = XLSX.utils.table_to_sheet(table);

    XLSX.utils.book_append_sheet(workbook, worksheet, "Unbilled Report");

    // Download Excel file
    XLSX.writeFile(workbook, "Unbilled_Report.xlsx");
}
</script>

<script>
    function printDiv() {

        var divToPrint = document.getElementById('resultDiv');

        var WindowObject = window.open('', 'Print-Window');
        WindowObject.document.open();
        WindowObject.document.writeln('<!DOCTYPE html>');
        WindowObject.document.writeln('<html><head><title></title><style type="text/css">');


        WindowObject.document.writeln('@media print { .center { text-align: center;}' +
            '                                         .inline { display: inline; }' +
            '                                         .underline { text-decoration: underline; }' +
            '                                         .left { margin-left: 315px;} ' +
            '                                         .right { margin-right: 375px; display: inline; }' +
            '                                          table { border-collapse: collapse; font-size: 10px;}' +
            '                                          th, td { border: 1px solid black; border-collapse: collapse; padding: 6px; font-family: Arial, Helvetica, sans-serif;}' +
            '                                           th, td {text-align: left;}' +
            '.table .thead-dark th {color: #fff; background-color: #1c2d41;}'+
            ' tfoot{font-weight: 700; color: #000;}'+
            ' .printBtnDate{display: none;}'+ '.no-print{ display: none !important;}'+
            '                                         .border { border: 1px solid black; } ' +
            '                                         .bottom { bottom: 5px; width: 100%; position: fixed ' +
            '                                       ' +
            '                                   } } </style>');
        WindowObject.document.writeln('</head><body onload="window.print()">');
        WindowObject.document.writeln(divToPrint.innerHTML);
        WindowObject.document.writeln('</body></html>');
        WindowObject.document.close();
       
        setTimeout(function () {
            WindowObject.close();
        }, 10);

    }
</script>