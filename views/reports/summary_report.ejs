                success: function (res) {
                    // console.log(res); // 👈 check actual response in browser console
                    if (res.msg && res.msg.suc > 0 && res.msg.msg && res.msg.msg.length > 0) {
                    //  if (res.suc > 0 && res.msg.msg.length > 0) {
                        let options = '<option value="">Select Operator Name</option>';
                        options += '<option value="A">All Operators</option>';
                        res.msg.msg.forEach(op => {
                            options += `<option value="${op.operator_id}">${op.operator_name}</option>`;
                        });
                        $("#operator_id").html(options).val("A");
                    } else {
                        $("#operator_id").html('<option value="">No Operator Found</option>');
                    }
                },
                error: function () {
                    $("#operator_id").html('<option value="">Error loading operators</option>');
                }
            });
        } else {
            $("#operator_id").html('<option value="">Select Operator Name</option>');
        }
    });
});
</script>

<script>
$("#btnExcel").on("click", function () {

    var frm_dt = $("#frm_dt").val();
    var to_dt = $("#to_dt").val();
    var pay_mode = $("#pay_mode").val();
    var custId = $("#custId").val();  
    var operator_id = $("#operator_id").val(); 

    if (!frm_dt || !to_dt || !pay_mode || !custId || !operator_id) {
        alert("Please select all filters before downloading!");
        return;
    }

    $.ajax({
        url: "/report/get_details_report_excel",
        type: "POST",
        data: { frm_dt, to_dt, pay_mode, custId, operator_id },
        beforeSend: function () {
            $(".preloader").fadeIn();
        },
        success: function (res) {
            if (res.suc === 1) {
                generateExcel(res.data);
            } else {
                alert("No Data Found!");
            }
        },
        complete: function () {
            $(".preloader").fadeOut();
        }
    });
});

function generateExcel(data) {

    let rows = [];

    // HEADER
    rows.push([
        "#", "Receipt No", "Receipt No", "Date Time In", "Machine In",
        "Vehicle Type", "Vehicle No", "Date Time Out",
       "Machine Out", "Base Amount", "Advance Amount", "CGST", "SGST", "MIS Charges", "Net Amount", "Mode", "Operator Name"
    ]);

    // DETAILS ROWS
    data.forEach((dt, i) => {

        let netAmt = Number(dt.base_amt || 0) + Number(dt.advance_amt || 0) + Number(dt.cgst || 0) + Number(dt.sgst || 0) + Number(dt.other_charges || 0);

        rows.push([
            i + 1,
            dt.receipt_no,
            dt.receipt_no ? String(dt.receipt_no).slice(-5) : "",
            dt.date_time_in,
            dt.device_id,
            dt.vehicle_name,
            dt.vehicle_no,
            dt.date_time_out,
            dt.device_id_out,
            Number(dt.base_amt || 0).toFixed(2),
            Number(dt.advance_amt || 0).toFixed(2),
            Number(dt.cgst || 0).toFixed(2),
            Number(dt.sgst || 0).toFixed(2),
            Number(dt.other_charges || 0).toFixed(2),
            netAmt.toFixed(2),
            dt.pay_mode === "U" ? "UPI" : dt.pay_mode === "C" ? "CASH" : "",
            dt.operator_name
        ]);
    });

    // GENERATE
    let workbook = XLSX.utils.book_new();
    let worksheet = XLSX.utils.aoa_to_sheet(rows);

    // ✅ FORCE RECEIPT NO COLUMN AS TEXT
    let totalRows = rows.length;
    for (let i = 2; i <= totalRows; i++) {
        let cellRef = "B" + i;
        if (worksheet[cellRef]) {
            worksheet[cellRef].z = "@";
            worksheet[cellRef].t = "s";
        }
    }

    XLSX.utils.book_append_sheet(workbook, worksheet, "Detail Report");

    XLSX.writeFile(workbook, "Detail_Report_All.xlsx");
}
</script>


