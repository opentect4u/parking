<div id="pageLoader">
    <div class="loader">
        <div class="circle"></div>
        <div class="circle"></div>
        <div class="circle"></div>
        <div class="shadow"></div>
        <div class="shadow"></div>
        <div class="shadow"></div>
    </div>
</div>

<script>
let table;

/* 🔄 Reset Vehicle Search */
$('#btnVehicleReset').on('click', function () {
    $('#vehicleSearch').val('');
    if (table) table.ajax.reload();
});

/* 🔄 Location change reset */
$('#custId').on('change', function () {
    $('#vehicleSearch').val('');
    $('#vehicleSearchSection').hide();
});

/* 🔍 Main Search */
$('#btnSubmit').on('click', function () {

    const frm_dt = $('#frm_dt').val();
    const to_dt = $('#to_dt').val();
    const custId = $('#custId').val();
    const pay_mode = $('#pay_mode').val();
    const operator_id = $('#operator_id').val();
    const custName = $("#custId option:selected").text();

    if (!frm_dt || !to_dt || !custId || !pay_mode || !operator_id) return;

    if (table) {
        table.destroy();
        $('#cust-datatable tbody').empty();
    }

    $('#resultDiv').show();
    $('#vehicleSearchSection').hide();
    $('#searchCred').html(
        `<b>Detail Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`
    );

    table = $('#cust-datatable').DataTable({
        processing: true,
        serverSide: true,
        searching: false,
        pageLength: 50,

        ajax: {
            url: "/report/get_details_report_new",
            type: "POST",
            data: function (d) {
                d.frm_dt = frm_dt;
                d.to_dt = to_dt;
                d.custId = custId;
                d.pay_mode = pay_mode;
                d.operator_id = operator_id;
                d.vehicle_no = $('#vehicleSearch').val(); // ✅ vehicle search
            },
            beforeSend: () => $('#pageLoader').fadeIn(),
            complete: () => $('#pageLoader').fadeOut()
        },

        drawCallback: function (settings) {
            if (settings.json && settings.json.data.length > 0) {
                $('#vehicleSearchSection').css('display', 'flex');
            } else {
                $('#vehicleSearchSection').hide();
            }
        },

        columns: [
    {
        data: null,
        render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1
    },
    { data: "receipt_no" },
    { data: "receipt_no", render: d => d ? String(d).slice(-5) : '' },
    { data: "date_time_in" },
    { data: "device_id" },
    { data: "vehicle_name" },
    { data: "vehicle_no" },
    { data: "date_time_out" },
    { data: "device_id_out" },
    { data: "base_amt", render: d => d ? parseFloat(d).toFixed(2) : "0.00" },
    { data: "advance_amt", render: d => d ? parseFloat(d).toFixed(2) : "0.00" },
    { data: "cgst", render: d => d ? parseFloat(d).toFixed(2) : "0.00" },
    { data: "sgst", render: d => d ? parseFloat(d).toFixed(2) : "0.00" },
    { data: "other_charges", render: d => d ? parseFloat(d).toFixed(2) : "0.00" },
    { 
        data: null, 
        render: (d, t, r) => {
            const total = (parseFloat(r.base_amt) || 0) + (parseFloat(r.advance_amt) || 0) + (parseFloat(r.cgst) || 0) + (parseFloat(r.sgst) || 0) + (parseFloat(r.other_charges) || 0);
            return total.toFixed(2);
        }
    },
    {
        data: "pay_mode",
        render: d => d === 'U' ? 'UPI' : d === 'C' ? 'CASH' : ''
    },
    { data: "operator_name" }
],
        footerCallback: function (row, data, start, end, display) {
            var api = this.api();
            
            var intVal = function (i) {
                return typeof i === 'string' ? i.replace(/[\$,]/g, '') * 1 : typeof i === 'number' ? i : 0;
            };

            var calculateTotal = function(index) {
                return api.column(index, { page: 'current' }).data().reduce(function (a, b) {
                    return intVal(a) + intVal(b);
                }, 0);
            };

            var totalBase = calculateTotal(9);
            var totalAdvance = calculateTotal(10);
            var totalCgst = calculateTotal(11);
            var totalSgst = calculateTotal(12);
            var totalOther = calculateTotal(13);
            
            var totalNet = api.rows({ page: 'current' }).data().reduce(function (a, b) {
                var rowTotal = (parseFloat(b.base_amt) || 0) + (parseFloat(b.advance_amt) || 0) + (parseFloat(b.cgst) || 0) + (parseFloat(b.sgst) || 0) + (parseFloat(b.other_charges) || 0);
                return a + rowTotal;
            }, 0);

            $(api.column(9).footer()).html('<b>' + totalBase.toFixed(2) + '</b>');
            $(api.column(10).footer()).html('<b>' + totalAdvance.toFixed(2) + '</b>');
            $(api.column(11).footer()).html('<b>' + totalCgst.toFixed(2) + '</b>');
            $(api.column(12).footer()).html('<b>' + totalSgst.toFixed(2) + '</b>');
            $(api.column(13).footer()).html('<b>' + totalOther.toFixed(2) + '</b>');
            $(api.column(14).footer()).html('<b>' + totalNet.toFixed(2) + '</b>');

            var json = api.ajax.json();
            if (json && json.grandTotals) {
                var pay_mode = $('#pay_mode').val();
                
                if (pay_mode === 'A') {
                    $('#tot_upi').parent().show();
                    $('#tot_cash').parent().show();
                    $('#tot_upi').html('<b>' + Number(json.grandTotals.tot_upi || 0).toFixed(2) + '</b>');
                    $('#tot_cash').html('<b>' + Number(json.grandTotals.tot_cash || 0).toFixed(2) + '</b>');
                } else if (pay_mode === 'U') {
                    $('#tot_upi').parent().show();
                    $('#tot_cash').parent().hide();
                    $('#tot_upi').html('<b>' + Number(json.grandTotals.tot_upi || 0).toFixed(2) + '</b>');
                } else if (pay_mode === 'C') {
                    $('#tot_upi').parent().hide();
                    $('#tot_cash').parent().show();
                    $('#tot_cash').html('<b>' + Number(json.grandTotals.tot_cash || 0).toFixed(2) + '</b>');
                }
            }
        }
    });
});

/* 🔍 Vehicle Search (SERVER SIDE ONLY) */
$('#btnVehicleSearch').on('click', function () {
    if (!$('#vehicleSearch').val().trim()) {
        alert("Please enter vehicle number");
        return;
    }
    table.ajax.reload();
});

/* Loader on pagination */
$('#cust-datatable').on('page.dt', () => $('#pageLoader').fadeIn());
$('#cust-datatable').on('draw.dt', () => $('#pageLoader').fadeOut());
</script>

    
