    <script>
        $('#btnSubmit').on('click', function(){
    var frm_dt = $('#frm_dt').val()
    var to_dt = $('#to_dt').val()
    var custId = $('#custId').val()
    var custName = $("#custId option:selected").text(); // Get selected location name
    
    if(frm_dt && to_dt && custId){
      $('#resultDiv').show();
      $('#resultDiv table tbody').empty();

      $('#searchCred').html(`<b>Device Wise Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);


        $.ajax({
            method: "POST",
            url: "/report/get_dev_wise_report_new",
            data: { frm_dt, to_dt, custId },
            dataType: "html",
            beforeSend: function () {
                $(".preloader").fadeIn();
            },
            success: function (result) {
                var res = JSON.parse(result);
                var net_amt_tot = 0, base_amt_tot = 0, advance_amt_tot = 0,
                    cgst_amt_tot = 0, sgst_amt_tot = 0, paid_amt_tot = 0, cnt_tot = 0, tot_amt_tot = 0;

                // $('#resultDiv').show();
                // $('#resultDiv table tbody').empty();

                if(res.suc > 0 && res.msg.length > 0){
                    // $('#searchCred').html(`<b>Device Wise Report from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);

                    let i = 1;
                    for(let dt of res.msg){
                        let base_amt = parseFloat(dt.base_amt);
                        let advance_amt = parseFloat(dt.advance_amt);
                        let cgst_amt = parseFloat(dt.cgst);
                        let sgst_amt = parseFloat(dt.sgst);
                        let paid_amt = parseFloat(dt.paid_amt);
                        let tot_vehi = parseInt(dt.tot_vehi);

                        net_amt_tot = paid_amt + advance_amt;

                        base_amt_tot += base_amt;
                        advance_amt_tot += advance_amt;
                        cgst_amt_tot += cgst_amt;
                        sgst_amt_tot += sgst_amt;
                        paid_amt_tot += paid_amt;
                        tot_amt_tot += net_amt_tot;
                        cnt_tot += tot_vehi;

                        $('#resultDiv table tbody').append(`
                            <tr>
                                <td class=text-dark>${i}</td>
                                <td class=text-dark>${dt.mc_srl_no_out}</td>
                                <td class=text-dark>${tot_vehi}</td>
                                <td class=text-dark>${base_amt.toFixed(2)}</td>
                                <td class=text-dark>${advance_amt.toFixed(2)}</td>
                                <td class=text-dark>${cgst_amt.toFixed(2)}</td>
                                <td class=text-dark>${sgst_amt.toFixed(2)}</td>
                                <td class=text-dark>${paid_amt.toFixed(2)}</td>
                                <td class=text-dark>${net_amt_tot.toFixed(2)}</td>
                            </tr>
                        `);
                        i++;
                    }

                    $('#tot_base').text(base_amt_tot.toFixed(2));
                    $('#tot_advance').text(advance_amt_tot.toFixed(2));
                    $('#tot_cgst').text(cgst_amt_tot.toFixed(2));
                    $('#tot_sgst').text(sgst_amt_tot.toFixed(2));
                    $('#tot_paid').text(paid_amt_tot.toFixed(2));
                    $('#tot_amt').text(tot_amt_tot.toFixed(2));
                    $('#tot_cnt').text(cnt_tot);
                } else {
                    $('#resultDiv table tbody').append('<tr><td colspan="9" class="text-center text-danger">No Data Found</td></tr>');
                }
            },
            complete: function () {
                $(".preloader").fadeOut();
            }
        })
    }
});

        </script>

<script>
function downloadExcel() {
    // Get the table element
    var table = document.querySelector("#resultDiv table");

    if (!table) {
        alert("No data available to export!");
        return;
    }

    // Convert table to worksheet
    var workbook = XLSX.utils.book_new();
    var worksheet = XLSX.utils.table_to_sheet(table);

    XLSX.utils.book_append_sheet(workbook, worksheet, "Device Report");

    // Download Excel file
    XLSX.writeFile(workbook, "Device_Report.xlsx");
}
</script>


<script>
    function printDiv() {

        var divToPrint = document.getElementById('resultDiv');

        var WindowObject = window.open('', 'Print-Window');
        WindowObject.document.open();
        WindowObject.document.writeln('<!DOCTYPE html>');
        WindowObject.document.writeln('<html><head><title></title><style type="text/css">');


        WindowObject.document.writeln('@media print { .center { text-align: center;}' +
            '                                         .inline { display: inline; }' +
            '                                         .underline { text-decoration: underline; }' +
            '                                         .left { margin-left: 315px;} ' +
            '                                         .right { margin-right: 375px; display: inline; }' +
            '                                          table { border-collapse: collapse; font-size: 10px;}' +
            '                                          th, td { border: 1px solid black; border-collapse: collapse; padding: 6px; font-family: Arial, Helvetica, sans-serif;}' +
            '                                           th, td {text-align: left;}' +
            '.table .thead-dark th {color: #fff; background-color: #1c2d41;}'+
            ' tfoot{font-weight: 700; color: #000;}'+
            ' .printBtnDate{display: none;}'+ '.no-print{ display: none !important;}'+
            '                                         .border { border: 1px solid black; } ' +
            '                                         .bottom { bottom: 5px; width: 100%; position: fixed ' +
            '                                       ' +
            '                                   } } </style>');
        WindowObject.document.writeln('</head><body onload="window.print()">');
        WindowObject.document.writeln(divToPrint.innerHTML);
        WindowObject.document.writeln('</body></html>');
        WindowObject.document.close();

        setTimeout(function () {
            WindowObject.close();
        }, 10);

    }
</script>